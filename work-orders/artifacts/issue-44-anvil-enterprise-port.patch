+def _copilot_usage(snapshot):
+    """Sum the per-model counters of a Copilot CLI accounting snapshot.
+
+    Copilot reports inputTokens with cache reads and writes already included.
+    """
+    metrics = snapshot.get("modelMetrics") if isinstance(snapshot, dict) else None
+    if not isinstance(metrics, dict) or not metrics:
+        return None
+    usages = []
+    for entry in metrics.values():
+        counters = entry.get("usage") if isinstance(entry, dict) else None
+        if not isinstance(counters, dict):
+            return None
+        usages.append(normalize_usage({
+            "input_tokens": counters.get("inputTokens"),
+            "output_tokens": counters.get("outputTokens"),
+            "cached_input_tokens": counters.get("cacheReadTokens", 0),
+            "cache_creation_input_tokens": counters.get("cacheWriteTokens", 0),
+            "reasoning_tokens": counters.get("reasoningTokens", 0),
+            "input_tokens_includes_cache": True,
+        }))
+    if any(u is None for u in usages):
+        return None
+    return sum_usage(usages)
+
+
+def _parse_copilot_output(raw, result):
+    """Read Copilot CLI JSONL (copilot -p ... --output-format json)."""
+    messages, turns, snapshot, final, events, errors = [], set(), None, None, 0, []
+    for line in raw.splitlines():
+        try:
+            event = json.loads(line)
+        except ValueError:
+            continue
+        if not isinstance(event, dict) or "type" not in event:
+            continue
+        events += 1
+        data = event.get("data") if isinstance(event.get("data"), dict) else {}
+        if event["type"] == "assistant.message" and not data.get("parentToolCallId"):
+            content = str(data.get("content") or "")
+            if content.strip():
+                messages.append(content)
+        elif event["type"] == "assistant.turn_end":
+            turns.add(data.get("turnId"))
+        elif event["type"] == "session.usage_checkpoint":
+            snapshot = data.get("accountingSnapshot")
+        elif event["type"] == "session.error":
+            errors.append(str(data.get("message") or "").strip())
+        elif event["type"] == "result":
+            final = event
+    if not events:
+        return result
+    # Copilot reports failures as session.error events on stdout, not on stderr.
+    result["error"] = "; ".join(e for e in errors if e)
+    result["output"] = "\n".join(messages)
+    result["usage"] = _copilot_usage(snapshot)
+    result["usage_complete"] = result["usage"] is not None
+    result["turns"] = len(turns)
+    if final is not None:
+        result["is_error"] = final.get("exitCode") not in (0, None)
+    return result
+
