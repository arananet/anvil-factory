+#!/usr/bin/env python3
+"""Command executor target that runs ANVIL station packets through GitHub Copilot CLI.
+
+This is the optional copilot runtime (ANVIL_RUNTIME=copilot); the default is
+claude-codex. tools/dispatch_station.py invokes it with the
+rendered packet path and the output path. It reads the packet, learns the
+station from the packet's first line ("# Task packet: <station-id>"), and
+runs Copilot CLI in non-interactive mode in the project working tree:
+
+    copilot -p <packet> --model <copilot-model-id> --output-format json
+
+Models are reached through GitHub Copilot, so there is no separate AI
+gateway. ANVIL's concrete model ids are mapped to Copilot model ids
+(COPILOT_MODELS); an unknown model fails loudly with no fallback.
+
+Authentication: Copilot CLI reads COPILOT_GITHUB_TOKEN (then GH_TOKEN,
+GITHUB_TOKEN) or a stored `copilot login`. In GitHub Actions the workflow
+supplies COPILOT_GITHUB_TOKEN from a repository secret holding a
+fine-grained PAT with the "Copilot Requests" permission. This script never
+reads or prints the token; it only inherits the environment.
+
+Station permissions follow the ANVIL separation of duties, the same as
+claude_station.py:
+
+- Producing stations (WRITE_STATIONS) run with --allow-all-tools and may
+  edit the working tree.
+- Reviewer stations may run shell commands (a tests reviewer runs the suite)
+  and may write exactly one file, their own review file
+  (--allow-tool shell --allow-tool write(runs/<id>/<station>.review.json)).
+- Every other station (scout, observer, supervisor) may only run shell
+  commands.
+- Stations that may not edit still reach URLs (--allow-all-urls), for example
+  a facts reviewer checking a source or a reviewer reading a served page.
+
+Non-interactive mode cannot answer permission prompts, so anything not
+allowed is refused; Copilot's agent also declines to write files through
+the shell when its write tools are denied, which is why reviewers get a
+path-scoped write rule instead. The sandbox is the throwaway Actions runner.
+Built-in MCP servers and repository custom instructions are disabled so the
+packet is the station's whole context.
+
+Failure behavior: a non-zero Copilot exit, a timeout, or empty output makes
+this script exit non-zero, so the runner marks the step failed.
+"""
+
+import json
+import os
+import subprocess
+import sys
+import time
+from pathlib import Path
+
+TOOLS_DIR = Path(__file__).resolve().parent
+sys.path.insert(0, str(TOOLS_DIR.parent))
+sys.path.insert(0, str(TOOLS_DIR))
+from anvil.telemetry import UsageRecorder  # noqa: E402
+from claude_station import (  # noqa: E402
+    WRITE_STATIONS,
+    review_suffix,
+    station_of,
+    transcript_path,
+    validate_review_file,
+    work_order_id_of,
+)
+
+TIMEOUT_SECONDS = 1500
+RUNTIME = "copilot"
+# Told to stations that may not edit, after a live run showed a reviewer
+# losing its test run by bundling it with a shell redirect into its review file.
+READ_ONLY_NOTE = (
+    "\n\n## Runtime permissions\n\n"
+    "Shell commands that write files (for example `>` redirection or `tee`) are refused, "
+    "and a refused command does not run at all. Run checks such as the test suite as "
+    "their own shell commands, without redirecting output into files.{review}\n"
+)
+REVIEW_FILE_NOTE = " Write your review file with the file create tool, not through the shell."
+
+# ANVIL concrete model id -> GitHub Copilot model id.
+COPILOT_MODELS = {
+    "claude-opus-5-5": "claude-opus-5.5",
+    "claude-sonnet-5-5": "claude-sonnet-5.5",
+    "openai/gpt-6.1-sol": "gpt-6.1-sol",
+}
+
+
+def copilot_model_id(model):
+    """Map an ANVIL concrete model to its Copilot id; refuse anything unknown."""
+    if model not in COPILOT_MODELS:
+        raise ValueError(f"copilot_station: unknown model '{model}'. "
+                         f"Known models: {', '.join(COPILOT_MODELS)}")
+    return COPILOT_MODELS[model]
+
+
+def copilot_command(prompt, copilot_model, station, review_file=None):
+    """Build the non-interactive Copilot CLI invocation (argv carries no credential).
+
+    review_file is the reviewer's own review path relative to the project root,
+    the only file a reviewer may write.
+    """
+    command = [
+        "copilot", "-p", prompt,
+        "--model", copilot_model,
+        "--output-format", "json",
+        "--no-ask-user",
+        "--disable-builtin-mcps",
+        "--no-custom-instructions",
+    ]
+    if station in WRITE_STATIONS:
+        command.append("--allow-all-tools")
+    else:
+        # URL access is not an edit: read only stations keep it, as under Claude Code.
+        command += ["--allow-tool", "shell", "--allow-all-urls"]
+        if review_file:
+            command += ["--allow-tool", f"write({review_file})"]
+    effort = os.environ.get("ANVIL_COPILOT_REASONING_EFFORT", "").strip()
+    if effort:
+        command += ["--reasoning-effort", effort]
+    return command
+
+
+def main():
+    if len(sys.argv) != 3:
+        print("usage: copilot_station.py <packet> <output>", file=sys.stderr)
+        return 64
+    packet_path = Path(sys.argv[1])
+    output_path = Path(sys.argv[2])
+
+    model = os.environ.get("ANVIL_CONFIGURED_MODEL")
+    if not model:
+        print("copilot_station: ANVIL_CONFIGURED_MODEL environment variable not set", file=sys.stderr)
+        return 7
+    try:
+        copilot_model = copilot_model_id(model)
+    except ValueError as e:
+        print(str(e), file=sys.stderr)
+        return 7
+
+    try:
+        packet_text = packet_path.read_text(encoding="utf-8")
+        station = station_of(packet_text)
+        work_order_id = work_order_id_of(packet_text) if station.startswith("reviewer") else None
+    except ValueError as e:
+        print(f"copilot_station: path validation failed: {e}", file=sys.stderr)
+        return 6
+
+    repo_root = Path(os.environ.get("ANVIL_PROJECT_ROOT") or TOOLS_DIR.parent).resolve()
+    reviewer = station.startswith("reviewer") and work_order_id
+    review_file = f"runs/{work_order_id}/{station}.review.json" if reviewer else None
+    review_path = repo_root / "runs" / str(work_order_id) / f"{station}.review.json"
+    if reviewer:
+        review_path.parent.mkdir(parents=True, exist_ok=True)
+    correction_used = False
+    validation_error = ""
+    usage_recorder = UsageRecorder()
+    output = ""
+
+    for attempt in range(min(2, int(os.environ.get("ANVIL_MAX_ATTEMPTS", "2")))):
+        if attempt and not usage_recorder.within_budget():
+            print("copilot_station: token threshold reached before correction", file=sys.stderr)
+            return 8
+        prompt = packet_text
+        if station not in WRITE_STATIONS:
+            prompt += READ_ONLY_NOTE.format(review=REVIEW_FILE_NOTE if reviewer else "")
+        if reviewer:
+            if attempt == 0:
+                prompt += review_suffix(work_order_id, station)
+            else:
+                prompt += (
+                    f"\n\n## Review file correction needed\n\n"
+                    f"The review file validation failed with this error:\n\n{validation_error}\n\n"
+                    f"Please correct the issue and write a valid review JSON object to "
+                    f"runs/{work_order_id}/{station}.review.json.\n"
+                )
+
+        try:
+            output_path.unlink()
+        except FileNotFoundError:
+            pass
+
+        call_started = time.perf_counter()
+        try:
+            proc = subprocess.run(copilot_command(prompt, copilot_model, station, review_file),
+                                  cwd=str(repo_root), capture_output=True,
+                                  text=True, timeout=TIMEOUT_SECONDS)
+        except subprocess.TimeoutExpired as exc:
+            usage_recorder.record(exc.stdout, RUNTIME, "timed_out",
+                                  (time.perf_counter() - call_started) * 1000, model)
+            print(f"copilot_station: station {station} timed out after {TIMEOUT_SECONDS}s",
+                  file=sys.stderr)
+            return 4
+        except FileNotFoundError:
+            print("copilot_station: the copilot CLI is not on PATH", file=sys.stderr)
+            return 5
+
+        parsed = usage_recorder.record(proc.stdout, RUNTIME,
+                                      "succeeded" if proc.returncode == 0 else "failed",
+                                      (time.perf_counter() - call_started) * 1000, model)
+        if proc.returncode != 0 or parsed.get("is_error"):
+            detail = (parsed.get("error") or proc.stderr or "").strip()[:2000]
+            print(f"copilot_station: copilot exited {proc.returncode} for station {station}: {detail}",
+                  file=sys.stderr)
+            return 2
+
+        output = parsed["output"]
+        # Station artifact contract: a station that wrote its own output file
+        # keeps it, and the chat reply is saved beside it as a transcript.
+        station_wrote_output = output_path.is_file() and bool(
+            output_path.read_text(encoding="utf-8", errors="replace").strip())
+        review_written = bool(reviewer) and validate_review_file(review_path, station)[0]
+        if not output.strip() and not (station_wrote_output or review_written):
+            print(f"copilot_station: copilot produced empty output for station {station}",
+                  file=sys.stderr)
+            return 3
+
+        if station_wrote_output:
+            if output.strip():
+                transcript_path(output_path, station).write_text(output, encoding="utf-8")
+            output = output_path.read_text(encoding="utf-8", errors="replace")
+        else:
+            output_path.write_text(output, encoding="utf-8")
+
+        if not reviewer:
+            break
+        is_valid, validation_error = validate_review_file(review_path, station)
+        if is_valid:
+            if correction_used:
+                metadata = {"correction_used": True, "attempts": attempt + 1}
+                review_path.with_name(f"{station}.correction.json").write_text(
+                    json.dumps(metadata, indent=2) + "\n", encoding="utf-8")
+            break
+        if attempt == 0:
+            correction_used = True
+            continue
+        break
+
+    print(output)
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
