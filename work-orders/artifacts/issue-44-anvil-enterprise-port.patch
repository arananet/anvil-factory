+"""The project report refresh tool refuses private repositories unless told the site is private."""
+import json, sys, tempfile, unittest
+from pathlib import Path
+from unittest import mock
+
+ROOT = Path(__file__).resolve().parent.parent
+sys.path.insert(0, str(ROOT / "tools"))
+import sync_project_usage  # noqa: E402
+
+ENTRY = {"id": "poc", "name": "Poc", "repository": "example-org/poc"}
+
+
+def fake_github(path):
+    if path == "repos/example-org/poc":
+        return {"private": True, "default_branch": "main"}
+    if "/git/trees/" in path:
+        return {"sha": "abc", "tree": []}
+    raise AssertionError(f"unexpected GitHub read: {path}")
+
+
+class TestPrivateRepositoryGuard(unittest.TestCase):
+    def test_private_repository_needs_explicit_opt_in(self):
+        with tempfile.TemporaryDirectory() as tmp, \
+             mock.patch.object(sync_project_usage, "github", fake_github):
+            with self.assertRaises(ValueError) as ctx:
+                sync_project_usage.sync_project(ENTRY, Path(tmp))
+            self.assertIn("--allow-private", str(ctx.exception))
+            self.assertFalse((Path(tmp) / "poc").exists())
+
+            root = sync_project_usage.sync_project(ENTRY, Path(tmp), allow_private=True)
+            snapshot = json.loads((root / "report_exports.json").read_text())
+            self.assertEqual(snapshot["repository"], "example-org/poc")
+            self.assertEqual(snapshot["reports"], [])
+
+
+if __name__ == "__main__":
+    unittest.main()
