diff --git a/tests/test_copilot_runtime.py b/tests/test_copilot_runtime.py
new file mode 100644
index 0000000..563d29c
--- /dev/null
+++ b/tests/test_copilot_runtime.py
@@ -0,0 +1,219 @@
+"""GitHub Copilot CLI is an optional station runtime (ANVIL_RUNTIME=copilot).
+
+A fake `copilot` executable on PATH stands in for the CLI; it records argv and
+cwd, writes reviewer review files, and emits Copilot JSONL events.
+"""
+import json, os, shutil, stat, subprocess, sys, tempfile, unittest
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent.parent
+sys.path.insert(0, str(ROOT))
+from anvil.telemetry import parse_runtime_output  # noqa: E402
+
+COPILOT = ROOT / "tools" / "copilot_station.py"
+DISPATCH = ROOT / "tools" / "dispatch_station.py"
+
+FAKE = '''#!/usr/bin/env python3
+import json, os, sys
+from pathlib import Path
+rec = Path(os.environ["FAKE_RECORD"])
+n = len(rec.read_text().splitlines()) if rec.exists() else 0
+with rec.open("a") as fh:
+    fh.write(json.dumps({"argv": sys.argv[1:], "cwd": os.getcwd()}) + "\\n")
+mode = os.environ.get("FAKE_MODE", "")
+wo, st = os.environ.get("FAKE_WO"), os.environ.get("FAKE_STATION")
+if wo and st:
+    p = Path(os.getcwd()) / "runs" / wo / (st + ".review.json")
+    p.parent.mkdir(parents=True, exist_ok=True)
+    if mode == "invalid_then_valid" and n == 0:
+        p.write_text("not json")
+    else:
+        p.write_text(json.dumps({"station": st, "verdict": "pass", "findings": []}))
+usage = {"inputTokens": 120, "outputTokens": 30, "cacheReadTokens": 20,
+         "cacheWriteTokens": 50, "reasoningTokens": 5}
+if mode == "fail":
+    print(json.dumps({"type": "session.error", "data": {"message": "Model is not available."}}))
+    print(json.dumps({"type": "result", "exitCode": 3}))
+    sys.exit(3)
+for event in (
+    {"type": "assistant.message", "data": {"content": "", "toolRequests": [{"name": "bash"}]}},
+    {"type": "assistant.turn_end", "data": {"turnId": "0"}},
+    {"type": "assistant.message", "data": {"content": "copilot did some work"}},
+    {"type": "assistant.turn_end", "data": {"turnId": "1"}},
+    {"type": "session.usage_checkpoint",
+     "data": {"accountingSnapshot": {"modelMetrics": {"m": {"usage": usage}}}}},
+    {"type": "result", "exitCode": 0},
+):
+    print(json.dumps(event))
+'''
+
+
+class Harness:
+    def __init__(self, tc):
+        self.tmp = Path(tempfile.mkdtemp())
+        tc.addCleanup(shutil.rmtree, self.tmp, True)
+        self.bin = self.tmp / "bin"
+        self.bin.mkdir()
+        fake = self.bin / "copilot"
+        fake.write_text(FAKE)
+        fake.chmod(fake.stat().st_mode | stat.S_IXUSR)
+        self.project = self.tmp / "project"
+        self.project.mkdir()
+        self.record = self.tmp / "record.jsonl"
+        self.wo = "wo-copilot-test"
+
+    def run(self, station, model="claude-opus-5-5", script=COPILOT, **extra):
+        packet = self.tmp / f"{station}.packet.md"
+        packet.write_text(f"# Task packet: {station}\n\n- id: {self.wo}\n\nDo the work.\n")
+        out = self.tmp / f"{station}.out.md"
+        env = {k: v for k, v in os.environ.items() if k != "ANVIL_RUNTIME"}
+        env.update({"PATH": str(self.bin) + os.pathsep + str(Path(sys.executable).parent),
+                    "ANVIL_CONFIGURED_MODEL": model, "ANVIL_PROJECT_ROOT": str(self.project),
+                    "ANVIL_USAGE_PATH": str(self.tmp / "usage.json"),
+                    "FAKE_RECORD": str(self.record)})
+        if station.startswith("reviewer"):
+            env.update({"FAKE_WO": self.wo, "FAKE_STATION": station})
+        env.update(extra)
+        proc = subprocess.run([sys.executable, str(script), str(packet), str(out)],
+                              env=env, capture_output=True, text=True, timeout=60)
+        return proc, out
+
+    def calls(self):
+        if not self.record.exists():
+            return []
+        return [json.loads(line) for line in self.record.read_text().splitlines()]
+
+
+class TestCopilotOutputParsing(unittest.TestCase):
+    def test_reply_turns_and_usage_from_jsonl(self):
+        usage = {"inputTokens": 100, "outputTokens": 10, "cacheReadTokens": 40,
+                 "cacheWriteTokens": 30, "reasoningTokens": 4}
+        raw = "\n".join(json.dumps(e) for e in (
+            {"type": "assistant.message", "data": {"content": "first"}},
+            {"type": "assistant.turn_end", "data": {"turnId": "0"}},
+            {"type": "assistant.message", "data": {"content": "nested", "parentToolCallId": "t1"}},
+            {"type": "assistant.message", "data": {"content": "second"}},
+            {"type": "assistant.turn_end", "data": {"turnId": "1"}},
+            {"type": "session.usage_checkpoint", "data": {"accountingSnapshot": {
+                "modelMetrics": {"a": {"usage": usage}, "b": {"usage": usage}}}}},
+            {"type": "result", "exitCode": 0},
+        ))
+        parsed = parse_runtime_output(raw, "copilot")
+        self.assertEqual(parsed["output"], "first\nsecond")
+        self.assertEqual(parsed["turns"], 2)
+        self.assertTrue(parsed["usage_complete"])
+        self.assertFalse(parsed["is_error"])
+        self.assertEqual(parsed["usage"]["input_tokens"], 200)
+        self.assertEqual(parsed["usage"]["output_tokens"], 20)
+        self.assertEqual(parsed["usage"]["cached_input_tokens"], 80)
+        self.assertEqual(parsed["usage"]["cache_creation_input_tokens"], 60)
+        self.assertEqual(parsed["usage"]["total_tokens"], 220)
+
+    def test_missing_usage_stays_unknown_and_nonzero_exit_is_error(self):
+        raw = "\n".join(json.dumps(e) for e in (
+            {"type": "assistant.message", "data": {"content": "partial"}},
+            {"type": "result", "exitCode": 1},
+        ))
+        parsed = parse_runtime_output(raw, "copilot")
+        self.assertIsNone(parsed["usage"])
+        self.assertFalse(parsed["usage_complete"])
+        self.assertTrue(parsed["is_error"])
+
+
+class TestCopilotStation(unittest.TestCase):
+    def test_reviewer_runs_mapped_model_and_may_write_only_its_review(self):
+        h = Harness(self)
+        proc, out = h.run("reviewer-design", model="claude-opus-5-5")
+        self.assertEqual(proc.returncode, 0, proc.stderr)
+        call = h.calls()[0]
+        argv = call["argv"]
+        self.assertEqual(Path(call["cwd"]).resolve(), h.project.resolve())
+        self.assertEqual(argv[argv.index("--model") + 1], "claude-opus-5.5")
+        self.assertNotIn("--allow-all-tools", argv)
+        allowed = [argv[i + 1] for i, a in enumerate(argv) if a == "--allow-tool"]
+        self.assertEqual(allowed, ["shell", f"write(runs/{h.wo}/reviewer-design.review.json)"])
+        self.assertIn("--no-custom-instructions", argv)
+        prompt = argv[argv.index("-p") + 1]
+        self.assertIn("Do the work.", prompt)
+        self.assertIn("Write your review file with the file create tool", prompt)
+        self.assertEqual(out.read_text(), "copilot did some work")
+        usage = json.loads((h.tmp / "usage.json").read_text())
+        self.assertEqual(usage["attempts"][0]["runtime"], "copilot")
+        self.assertEqual(usage["usage"]["total_tokens"], 150)
+
+    def test_builder_may_write(self):
+        h = Harness(self)
+        proc, _ = h.run("builder", model="openai/gpt-6.1-sol")
+        self.assertEqual(proc.returncode, 0, proc.stderr)
+        argv = h.calls()[0]["argv"]
+        self.assertIn("--allow-all-tools", argv)
+        self.assertNotIn("--allow-tool", argv)
+        self.assertNotIn("Runtime permissions", argv[argv.index("-p") + 1])
+        self.assertEqual(argv[argv.index("--model") + 1], "gpt-6.1-sol")
+
+    def test_read_only_station_gets_shell_only(self):
+        h = Harness(self)
+        proc, _ = h.run("supervisor")
+        self.assertEqual(proc.returncode, 0, proc.stderr)
+        argv = h.calls()[0]["argv"]
+        self.assertNotIn("--allow-all-tools", argv)
+        self.assertIn("--allow-all-urls", argv)
+        self.assertEqual([argv[i + 1] for i, a in enumerate(argv) if a == "--allow-tool"], ["shell"])
+
+    def test_one_review_correction(self):
+        h = Harness(self)
+        proc, _ = h.run("reviewer-tests", FAKE_MODE="invalid_then_valid")
+        self.assertEqual(proc.returncode, 0, proc.stderr)
+        self.assertEqual(len(h.calls()), 2)
+        retry = h.calls()[1]["argv"]
+        self.assertIn("Review file correction needed", retry[retry.index("-p") + 1])
+        correction = h.project / "runs" / h.wo / "reviewer-tests.correction.json"
+        self.assertEqual(json.loads(correction.read_text())["attempts"], 2)
+
+    def test_copilot_failure_and_unknown_model_fail_loudly(self):
+        h = Harness(self)
+        proc, out = h.run("builder", FAKE_MODE="fail")
+        self.assertNotEqual(proc.returncode, 0)
+        self.assertFalse(out.exists())
+        self.assertIn("Model is not available.", proc.stderr)
+        proc, _ = h.run("builder", model="claude-sonnet-4-5")
+        self.assertNotEqual(proc.returncode, 0)
+        self.assertIn("unknown model", proc.stderr)
+        self.assertEqual(len(h.calls()), 1)
+
+
+class TestDispatcherRuntimeSelection(unittest.TestCase):
+    def test_copilot_runs_every_known_model_when_selected(self):
+        """With ANVIL_RUNTIME=copilot every known model runs on Copilot CLI"""
+        h = Harness(self)
+        for model in ("claude-opus-5-5", "claude-sonnet-5-5", "openai/gpt-6.1-sol"):
+            proc, out = h.run("builder", model=model, script=DISPATCH, ANVIL_RUNTIME="copilot")
+            self.assertEqual(proc.returncode, 0, proc.stderr)
+            self.assertIn(json.dumps({"model": model}), out.read_text())
+        self.assertEqual(len(h.calls()), 3)
+
+    def test_claude_codex_stays_the_default_runtime(self):
+        """With ANVIL_RUNTIME unset the dispatcher routes by model family, as before"""
+        sys.path.insert(0, str(ROOT / "tools"))
+        import dispatch_station
+        self.assertEqual(dispatch_station.DEFAULT_RUNTIME, "claude-codex")
+        route = dispatch_station.runtime_script
+        self.assertEqual(route("claude-codex", "claude-opus-5-5"), "claude_station.py")
+        self.assertEqual(route("claude-codex", "claude-sonnet-5-5"), "claude_station.py")
+        self.assertEqual(route("claude-codex", "openai/gpt-6.1-sol"), "codex_station.py")
+        self.assertEqual(route("copilot", "openai/gpt-6.1-sol"), "copilot_station.py")
+        self.assertIsNone(route("claude-codex", "claude-sonnet-4-5"))
+        h = Harness(self)
+        proc, _ = h.run("builder", script=DISPATCH)
+        self.assertEqual(h.calls(), [], "the default runtime must not call Copilot CLI")
+
+    def test_unknown_runtime_fails_loudly(self):
+        h = Harness(self)
+        proc, _ = h.run("builder", script=DISPATCH, ANVIL_RUNTIME="cloudflare")
+        self.assertEqual(proc.returncode, 1)
+        self.assertIn("unknown runtime", proc.stderr)
+        self.assertEqual(h.calls(), [])
+
+
+if __name__ == "__main__":
+    unittest.main()
