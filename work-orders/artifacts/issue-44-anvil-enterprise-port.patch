new file mode 100644
index 0000000..941fe64
--- /dev/null
+++ b/tests/test_secret_scan.py
@@ -0,0 +1,98 @@
+"""No credential may be committed: every file git tracks is scanned.
+
+Maps to operator-requirements S4 (a scan of the files finds no credential
+value). The scan covers what git would commit: tracked files plus untracked
+files that are not ignored.
+
+A test that needs a credential-shaped fixture must build it at runtime (see
+test_detector_flags_built_credentials), never write it as a literal.
+"""
+import os, re, subprocess, unittest
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent.parent
+
+PATTERNS = {
+    "GitHub token": r"\bgh[pousr]_[A-Za-z0-9]{36,}\b",
+    "GitHub fine-grained token": r"\bgithub_pat_[A-Za-z0-9_]{40,}\b",
+    "Anthropic key": r"\bsk-ant-[A-Za-z0-9_-]{20,}",
+    "OpenAI key": r"\bsk-(?:proj-)?[A-Za-z0-9_-]{32,}",
+    "AWS access key id": r"\b(?:AKIA|ASIA)[0-9A-Z]{16}\b",
+    "Google API key": r"\bAIza[0-9A-Za-z_-]{35}\b",
+    "Slack token": r"\bxox[baprs]-[A-Za-z0-9-]{10,}",
+    "Private key block": r"-----BEGIN (?:[A-Z]+ )*PRIVATE KEY-----",
+    "Azure storage key": r"AccountKey=[A-Za-z0-9+/=]{40,}",
+}
+COMPILED = {name: re.compile(pattern) for name, pattern in PATTERNS.items()}
+
+SECRET_FILE_NAMES = {".env", ".netrc", ".npmrc", ".pypirc", ".git-credentials",
+                     "credentials.json", "local.settings.json"}
+SECRET_FILE_SUFFIXES = (".pem", ".key", ".p12", ".pfx", ".jks", ".keystore", ".ppk",
+                        ".tfvars", ".tfstate")
+SKIP_DIRS = {".git", "node_modules", "__pycache__", ".venv", "venv"}
+
+
+def find_credentials(text):
+    """Return (pattern name, line number) for each credential-shaped string."""
+    found = []
+    for name, pattern in COMPILED.items():
+        for match in pattern.finditer(text):
+            found.append((name, text.count("\n", 0, match.start()) + 1))
+    return found
+
+
+def committed_files():
+    """Paths git would commit; falls back to walking the tree without git."""
+    try:
+        out = subprocess.run(["git", "ls-files", "-z", "--cached", "--others", "--exclude-standard"],
+                             cwd=ROOT, capture_output=True, timeout=60)
+        if out.returncode == 0 and out.stdout:
+            return [ROOT / name for name in out.stdout.decode("utf-8").split("\0") if name]
+    except (OSError, subprocess.TimeoutExpired):
+        pass
+    paths = []
+    for folder, dirs, names in os.walk(ROOT):
+        dirs[:] = [d for d in dirs if d not in SKIP_DIRS]
+        paths += [Path(folder) / name for name in names]
+    return paths
+
+
+class TestSecretScan(unittest.TestCase):
+    def test_no_credential_shaped_strings_s4(self):
+        """operator-requirements S4: no credential-shaped string in any committed file"""
+        problems = []
+        for path in committed_files():
+            try:
+                data = path.read_bytes()
+            except OSError:
+                continue
+            if b"\0" in data[:8192]:
+                continue
+            for name, line in find_credentials(data.decode("utf-8", errors="replace")):
+                problems.append(f"{path.relative_to(ROOT)}:{line}: {name}")
+        self.assertEqual(problems, [], "Credential-shaped strings found (values not shown):\n" + "\n".join(problems))
+
+    def test_no_secret_files_committed(self):
+        """Secret bearing file types are never committed, even with git add -f"""
+        problems = [str(path.relative_to(ROOT)) for path in committed_files()
+                    if path.name in SECRET_FILE_NAMES
+                    or (path.name.startswith(".env.") and path.name not in (".env.example", ".env.sample", ".env.template"))
+                    or path.name.endswith(SECRET_FILE_SUFFIXES)]
+        self.assertEqual(problems, [], "Secret bearing files must not be committed")
+
+    def test_detector_flags_built_credentials(self):
+        """The detector works: fixtures are built at runtime so this file stays clean"""
+        samples = {
+            "GitHub token": "gh" + "p_" + "a" * 36,
+            "GitHub fine-grained token": "github" + "_pat_" + "A1" * 30,
+            "AWS access key id": "AK" + "IA" + "Q" * 16,
+            "Private key block": "-----BEGIN " + "RSA PRIVATE KEY-----",
+        }
+        for name, sample in samples.items():
+            with self.subTest(name=name):
+                self.assertIn(name, [found for found, _ in find_credentials(f"line one\nvalue = {sample}\n")])
+        self.assertEqual(find_credentials("design/tokens.json and a task-list are not credentials"), [])
+
+
+if __name__ == "__main__":
+    unittest.main()
