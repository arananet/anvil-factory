+def change_under_review(project_dir, base_ref, changed_files, max_tokens=12000):
+    """The change itself, for the clean context reviewer: a diff and nothing else.
+
+    With a git base ref it is the diff against that ref plus the content of
+    untracked files. Without one it is the content of the files the builder
+    changed. The spec, the brain, run output and reviews are left out: the
+    reviewer is meant to reason from the code alone. The text is cut at
+    max_tokens (estimated) and the cut is stated.
+    """
+    project = Path(project_dir)
+    budget = int(max_tokens * CHARS_PER_TOKEN)
+
+    def excluded(rel):
+        parts = str(rel).replace("\\", "/").split("/")
+        return parts[0] in CLEAN_REVIEW_EXCLUDED or "__pycache__" in parts
+
+    def file_block(rel):
+        try:
+            text = (project / rel).read_text(encoding="utf-8")
+        except (OSError, UnicodeDecodeError):
+            return f"### {rel}\n\n(binary, unreadable or deleted)\n"
+        return f"### {rel} (new or changed file)\n\n```\n{text}\n```\n"
+
+    blocks = []
+    used_git = False
+    if base_ref:
+        import subprocess
+        try:
+            pathspec = ["--", "."] + [f":(exclude){name}" for name in CLEAN_REVIEW_EXCLUDED]
+            diff = subprocess.run(["git", "diff", str(base_ref)] + pathspec, cwd=str(project),
+                                  capture_output=True, text=True, timeout=60)
+            if diff.returncode == 0:
+                used_git = True
+                if diff.stdout.strip():
+                    blocks.append("```diff\n" + diff.stdout.rstrip("\n") + "\n```\n")
+                others = subprocess.run(["git", "ls-files", "--others", "--exclude-standard"], cwd=str(project),
+                                        capture_output=True, text=True, timeout=60)
+                if others.returncode == 0:
+                    for rel in sorted(line.strip() for line in others.stdout.splitlines() if line.strip()):
+                        if not excluded(rel):
+                            blocks.append(file_block(rel))
+        except (OSError, subprocess.SubprocessError):
+            used_git = False
+    if not used_git:
+        for rel in sorted(str(f) for f in (changed_files or [])):
+            if not excluded(rel) and (project / rel).is_file():
+                blocks.append(file_block(rel))
+    if not blocks:
+        return "No change was found to review: no file differs from the base."
+    kept, size, dropped = [], 0, 0
+    for block in blocks:
+        if size + len(block) > budget and kept:
+            dropped += 1
+            continue
+        if len(block) > budget:
+            block = block[:budget] + "\n(cut here: this part of the change is larger than the packet allows)\n"
+        kept.append(block)
+        size += len(block)
+    text = "\n".join(kept)
+    if dropped:
+        text += (f"\n({dropped} more changed files are not shown: the change is larger than the packet allows. "
+                 f"Say in your findings what you could not cover.)\n")
+    return text
