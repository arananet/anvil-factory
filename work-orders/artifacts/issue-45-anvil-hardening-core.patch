+"""Tests for .openspec/specs/run-resume/spec.md (S1 to S7)."""
+import json
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+from hardening_helpers import REVIEWERS, ScriptedExecutor, line, make_project, read_report  # noqa: E402
+
+from anvil.model import WorkOrder  # noqa: E402
+from anvil.runner import run_pipeline  # noqa: E402
+from anvil.statuspage import collect_runs  # noqa: E402
+from anvil.telemetry import summarize_steps  # noqa: E402
+
+
+def crash(project):
+    raise RuntimeError("runner died")
+
+
+def abort_at(proj, wo_id, station, intake=None, risk=None):
+    """Run the line and crash it while the given station is running."""
+    executor = ScriptedExecutor(wo_id, intake=intake, actions={station: crash})
+    try:
+        run_pipeline(proj, line(), WorkOrder(id=wo_id, kind="feature", title="T", risk=risk), executor=executor)
+    except RuntimeError:
+        pass
+    return executor
+
+
+def resume(proj, wo_id, **kwargs):
+    executor = ScriptedExecutor(wo_id, **kwargs)
+    report = run_pipeline(proj, line(), WorkOrder(id=wo_id, kind="feature", title="T"),
+                          executor=executor, resume=True)
+    return executor, report
+
+
+class TestResume(unittest.TestCase):
+    def test_s1_s2_resume_continues_from_the_interrupted_station(self):
+        """run-resume S1, S2: finished stations are not called again and their steps are carried."""
+        with tempfile.TemporaryDirectory() as tmp:
+            proj = make_project(tmp)
+            abort_at(proj, "wo-rr-1", "builder")
+            aborted_run_id = read_report(proj, "wo-rr-1")["run_id"]
+            executor, report = resume(proj, "wo-rr-1")
+            self.assertEqual(executor.calls, ["builder"] + REVIEWERS)
+            self.assertEqual(report.verdict, "approved")
+            data = read_report(proj, "wo-rr-1")
+            self.assertEqual(data["run_state"], "completed")
+            self.assertEqual(data["resumed_from"],
+                             {"run_id": aborted_run_id, "resume_station": "builder", "carried_steps": 3})
+            carried = [s["station"] for s in data["steps"] if s.get("carried")]
+            self.assertEqual(carried, ["intake", "spec-writer", "test-writer"])
+            self.assertFalse(any(s.get("aborted") for s in data["steps"]))
+            # 3 carried calls and 5 new ones, 100 tokens each, each counted once.
+            self.assertEqual(data["token_usage"]["calls"], 8)
+            self.assertEqual(data["token_usage"]["total_tokens"], 800)
+
+    def test_s3_the_aborted_report_is_not_archived_twice(self):
+        """run-resume S3: the resumed report replaces the aborted one, so usage is not double counted."""
+        with tempfile.TemporaryDirectory() as tmp:
+            proj = make_project(tmp)
+            abort_at(proj, "wo-rr-3", "builder")
+            resume(proj, "wo-rr-3")
+            self.assertFalse((proj / "runs" / "wo-rr-3" / "history").exists())
+            runs, _ = collect_runs(proj, include_history=True)
+            self.assertEqual(len(runs), 1)
+            self.assertEqual(summarize_steps([s for r in runs for s in r["steps"]])["total_tokens"], 800)
+
+    def test_s4_carried_reviews_are_counted_by_the_approver(self):
+        """run-resume S4: reviews written before the interruption are read back and counted."""
+        with tempfile.TemporaryDirectory() as tmp:
+            proj = make_project(tmp)
+            abort_at(proj, "wo-rr-4", "reviewer-tests")
+            executor, report = resume(proj, "wo-rr-4")
+            self.assertEqual(executor.calls, ["reviewer-tests", "reviewer-architecture"])
+            self.assertEqual(report.verdict, "approved")
+            self.assertEqual([c["station"] for c in report.decision["approver"]["reviews_counted"]], REVIEWERS)
+
+    def test_s4_carried_review_that_is_gone_is_run_again(self):
+        """run-resume S4: a carried reviewer whose review file is missing is not trusted."""
+        with tempfile.TemporaryDirectory() as tmp:
+            proj = make_project(tmp)
+            abort_at(proj, "wo-rr-4b", "reviewer-architecture")
+            (proj / "runs" / "wo-rr-4b" / "reviewer-security.review.json").unlink()
+            executor, report = resume(proj, "wo-rr-4b")
+            self.assertEqual(executor.calls, ["reviewer-security", "reviewer-tests", "reviewer-architecture"])
+            self.assertEqual(report.verdict, "approved")
+
+    def test_s5_nothing_to_resume_runs_normally_with_a_warning(self):
+        """run-resume S5: resume with no aborted run, or after a finished one, starts from the first station."""
+        with tempfile.TemporaryDirectory() as tmp:
+            proj = make_project(tmp)
+            executor, report = resume(proj, "wo-rr-5")
+            self.assertEqual(executor.calls[0], "intake")
+            self.assertTrue(any("no aborted run" in w for w in report.warnings))
+            self.assertNotIn("resumed_from", read_report(proj, "wo-rr-5"))
+            # A finished run is not resumed: it is archived and the line starts over.
+            executor, report = resume(proj, "wo-rr-5")
+            self.assertEqual(executor.calls[0], "intake")
+            self.assertEqual(len(list((proj / "runs" / "wo-rr-5" / "history").glob("*.json"))), 1)
+
+    def test_s5_abort_at_the_first_station_has_nothing_to_carry(self):
+        """run-resume S5: an abort during intake carries nothing; the earlier report is archived."""
+        with tempfile.TemporaryDirectory() as tmp:
+            proj = make_project(tmp)
+            abort_at(proj, "wo-rr-5c", "intake")
+            executor, report = resume(proj, "wo-rr-5c")
+            self.assertEqual(executor.calls[0], "intake")
+            self.assertTrue(any("no completed station" in w for w in report.warnings))
+            self.assertEqual(len(list((proj / "runs" / "wo-rr-5c" / "history").glob("*.json"))), 1)
+
+    def test_s6_classification_and_routing_are_restored(self):
+        """run-resume S6: the panel decided before the interruption is the panel after it."""
+        with tempfile.TemporaryDirectory() as tmp:
+            proj = make_project(tmp)
+            low = {"intake_outcome": {"outcome": "accepted"}, "risk": "low", "surfaces": []}
+            abort_at(proj, "wo-rr-6", "builder", intake=low)
+            executor, report = resume(proj, "wo-rr-6")
+            self.assertEqual(executor.calls, ["builder", "reviewer-spec", "reviewer-tests"])
+            self.assertEqual(report.verdict, "approved")
+            self.assertEqual(report.decision["approver"]["reviews_expected"], ["reviewer-spec", "reviewer-tests"])
+
+    def test_s7_without_the_flag_an_aborted_run_is_archived_and_restarted(self):
+        """run-resume S7: resume is explicit; a plain rerun starts over and keeps the aborted report."""
+        with tempfile.TemporaryDirectory() as tmp:
+            proj = make_project(tmp)
+            abort_at(proj, "wo-rr-7", "builder")
+            executor = ScriptedExecutor("wo-rr-7")
+            run_pipeline(proj, line(), WorkOrder(id="wo-rr-7", kind="feature", title="T"), executor=executor)
+            self.assertEqual(executor.calls[0], "intake")
+            archived = list((proj / "runs" / "wo-rr-7" / "history").glob("*.json"))
+            self.assertEqual(json.loads(archived[0].read_text(encoding="utf-8"))["run_state"], "aborted")
+
+
+if __name__ == "__main__":
