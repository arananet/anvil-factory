+
+REDUCED = ["reviewer-spec", "reviewer-tests"]
+
+
+def intake(risk=None, surfaces=None):
+    data = {"intake_outcome": {"outcome": "accepted"}}
+    if risk is not None:
+        data["risk"] = risk
+    if surfaces is not None:
