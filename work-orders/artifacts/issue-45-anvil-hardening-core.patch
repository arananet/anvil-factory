index 0000000..113761e
--- /dev/null
+++ b/anvil/metrics.py
@@ -0,0 +1,93 @@
+"""Outcome metrics over recorded runs.
+
+One run report says how one attempt went. These figures say how the line
+performs: how often work is approved without a loopback, how often each
+reviewer objects, how often the checks gate stops work before review, and
+what an approved work order costs in tokens. They are computed from the run
+reports already on disk, never by running anything again.
+
+Spec: .openspec/specs/outcome-metrics/spec.md
+"""
+from .telemetry import summarize_steps
+
+APPROVER_VERDICTS = {"approved", "rejected", "changes_requested"}
+
+
+def _rate(part, whole):
+    return round(part / whole, 4) if whole else None
+
+
+def outcome_metrics(reports):
+    """Aggregate outcome figures from a list of run report dicts.
+
+    Every report is one run (the current report of a work order and each
+    archived earlier run). A rate is None when nothing was measured for it,
+    never zero.
+    """
+    reports = [r for r in (reports or []) if isinstance(r, dict)]
+    states = {"completed": 0, "aborted": 0, "in_progress": 0}
+    judged = approved = first_pass = loopbacks = budget_stopped = 0
+    gate_ran = gate_failed = violations = 0
+    reviewers = {}
+    work_orders = {}
+    for report in reports:
+        state = report.get("run_state") or "completed"
+        states[state] = states.get(state, 0) + 1
+        verdict = report.get("verdict")
+        wo = work_orders.setdefault(str(report.get("work_order_id", "")), {"approved": False})
+        if verdict == "budget_exceeded":
+            budget_stopped += 1
+        if verdict in APPROVER_VERDICTS:
+            judged += 1
+            run_loopbacks = report.get("loopbacks") or 0
+            loopbacks += run_loopbacks
+            if verdict == "approved":
+                approved += 1
+                wo["approved"] = True
+                if run_loopbacks == 0:
+                    first_pass += 1
+        gate_steps = [s for s in report.get("steps") or []
+                      if s.get("station") == "checks-gate" and s.get("status") in {"passed", "failed"}]
+        if gate_steps:
+            gate_ran += 1
+            if any(s.get("status") == "failed" for s in gate_steps):
+                gate_failed += 1
+        violations += len(((report.get("integrity") or {}).get("violations")) or [])
+        counted = ((report.get("decision") or {}).get("approver") or {}).get("reviews_counted") or []
+        for entry in counted:
+            if not isinstance(entry, dict) or not entry.get("station"):
+                continue
+            row = reviewers.setdefault(str(entry["station"]), {"reviews": 0, "objections": 0})
+            row["reviews"] += 1
+            if entry.get("verdict") != "pass":
+                row["objections"] += 1
+    for row in reviewers.values():
+        row["objection_rate"] = _rate(row["objections"], row["reviews"])
+    usage = summarize_steps([s for r in reports for s in r.get("steps") or []])
+    approved_work_orders = sum(1 for wo in work_orders.values() if wo["approved"])
+    # No agent call on record means nothing was measured, not zero tokens.
+    total_tokens = usage.get("total_tokens") if usage.get("calls") else None
+    return {
+        "schema": "anvil/outcomes@1",
+        "runs": len(reports),
+        "run_states": states,
+        "work_orders": len(work_orders),
+        "approved_work_orders": approved_work_orders,
+        "judged_runs": judged,
+        "approved_runs": approved,
+        "approval_rate": _rate(approved, judged),
+        "first_pass_approvals": first_pass,
+        "first_pass_approval_rate": _rate(first_pass, judged),
+        "loopbacks": loopbacks,
+        "loopbacks_per_judged_run": round(loopbacks / judged, 4) if judged else None,
+        "gate_runs": gate_ran,
+        "gate_failures": gate_failed,
+        "gate_failure_rate": _rate(gate_failed, gate_ran),
+        "budget_stopped_runs": budget_stopped,
+        "integrity_violations": violations,
+        "reviewers": {k: reviewers[k] for k in sorted(reviewers)},
+        "total_tokens": total_tokens,
+        "usage_complete": bool(usage.get("complete")),
+        "tokens_per_approved_work_order": (round(total_tokens / approved_work_orders)
+                                           if total_tokens is not None and approved_work_orders else None),
+    }
