+    if has_risk_proposal and proposed_risk is not None and proposed_risk not in RISK_ORDER:
+        decisions.append(f"Intake proposed risk '{proposed_risk}', which is not a known level; ignored.")
+    elif has_risk_proposal and proposed_risk is not None:
