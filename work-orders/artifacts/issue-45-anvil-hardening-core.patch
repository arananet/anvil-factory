+"""Tests for .openspec/specs/run-checkpoint/spec.md (S1 to S6)."""
+import json
+import os
+import signal
+import subprocess
+import sys
+import tempfile
+import time
+import unittest
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+from hardening_helpers import ROOT, ScriptedExecutor, line, make_project, read_report, write  # noqa: E402
+
+from anvil.model import WorkOrder  # noqa: E402
+from anvil.runner import run_pipeline, _write_json_atomic  # noqa: E402
+
+
+class TestCheckpointAfterEveryStation(unittest.TestCase):
+    def test_s1_report_is_saved_while_the_run_is_in_progress(self):
+        """run-checkpoint S1: the report on disk mid-run lists the finished stations and the one in flight."""
+        with tempfile.TemporaryDirectory() as tmp:
+            proj = make_project(tmp)
+            seen = {}
+
+            def builder(project):
+                seen.update(read_report(project, "wo-cp-1"))
+
+            run_pipeline(proj, line(), WorkOrder(id="wo-cp-1", kind="feature", title="T"),
+                         executor=ScriptedExecutor("wo-cp-1", actions={"builder": builder}))
+            self.assertEqual(seen["run_state"], "in_progress")
+            self.assertEqual(seen["verdict"], "incomplete")
+            self.assertEqual(seen["in_flight"]["station"], "builder")
+            self.assertEqual([s["station"] for s in seen["steps"]], ["intake", "spec-writer", "test-writer"])
+            self.assertEqual(seen["token_usage"]["total_tokens"], 300)
+
+    def test_s4_completed_run_records_completed(self):
+        """run-checkpoint S4: a run that reaches its end is completed, with no flight or abort fields."""
+        with tempfile.TemporaryDirectory() as tmp:
+            proj = make_project(tmp)
+            report = run_pipeline(proj, line(), WorkOrder(id="wo-cp-4", kind="feature", title="T"),
+                                  executor=ScriptedExecutor("wo-cp-4"))
+            data = read_report(proj, "wo-cp-4")
+            self.assertEqual(report.verdict, "approved")
+            self.assertEqual(data["run_state"], "completed")
+            self.assertNotIn("in_flight", data)
+            self.assertNotIn("abort_reason", data)
+
+    def test_s4_packet_mode_run_is_completed(self):
+        """run-checkpoint S4: packet mode (no runtime) also ends completed."""
+        with tempfile.TemporaryDirectory() as tmp:
+            proj = make_project(tmp)
+            run_pipeline(proj, line(), WorkOrder(id="wo-cp-4b", kind="feature", title="T"))
+            data = read_report(proj, "wo-cp-4b")
+            self.assertEqual(data["run_state"], "completed")
+            # Packets only: the approver has no reviews to count.
+            self.assertEqual(data["verdict"], "no_reviews")
+
+
+class TestAbortedRunKeepsItsAccounting(unittest.TestCase):
+    def test_s2_crash_leaves_an_aborted_report_and_reraises(self):
+        """run-checkpoint S2: a crash mid-run is re-raised and the report keeps every completed step."""
+        with tempfile.TemporaryDirectory() as tmp:
+            proj = make_project(tmp)
+
+            def builder(project):
+                raise RuntimeError("boom in builder")
+
+            with self.assertRaises(RuntimeError):
+                run_pipeline(proj, line(), WorkOrder(id="wo-cp-2", kind="feature", title="T"),
+                             executor=ScriptedExecutor("wo-cp-2", actions={"builder": builder}))
+            data = read_report(proj, "wo-cp-2")
+            self.assertEqual(data["run_state"], "aborted")
+            self.assertIn("boom in builder", data["abort_reason"])
+            self.assertEqual(data["verdict"], "incomplete")
+            stations = [s["station"] for s in data["steps"]]
+            self.assertEqual(stations[:3], ["intake", "spec-writer", "test-writer"])
+            self.assertEqual(data["in_flight"]["station"], "builder")
+
+    def test_s3_interrupted_station_keeps_the_usage_it_reported(self):
+        """run-checkpoint S3: the interrupted station is a failed step carrying its reported usage."""
+        with tempfile.TemporaryDirectory() as tmp:
+            proj = make_project(tmp)
+            usage = {"input_tokens": 700, "output_tokens": 50}
+
+            def builder(project):
+                write(project, "runs/wo-cp-3/builder.output.md.usage.json", json.dumps({
+                    "schema": "anvil/usage@1", "usage": usage, "complete": True,
+                    "attempts": [{"attempt": 1, "status": "timed_out", "usage": usage, "usage_complete": True}]}))
+                raise KeyboardInterrupt()
+
+            with self.assertRaises(KeyboardInterrupt):
+                run_pipeline(proj, line(), WorkOrder(id="wo-cp-3", kind="feature", title="T"),
+                             executor=ScriptedExecutor("wo-cp-3", actions={"builder": builder}))
+            data = read_report(proj, "wo-cp-3")
+            self.assertEqual(data["run_state"], "aborted")
+            step = data["steps"][-1]
+            self.assertEqual((step["station"], step["status"], step["aborted"]), ("builder", "failed", True))
+            self.assertEqual(step["usage"]["total_tokens"], 750)
+            # 3 finished calls of 100 tokens plus the interrupted builder call.
+            self.assertEqual(data["token_usage"]["total_tokens"], 1050)
+            self.assertEqual(data["token_usage"]["by_station"]["builder"]["total_tokens"], 750)
+
+    def test_s3_interrupted_station_without_usage_is_an_unmeasured_call(self):
+        """run-checkpoint S3: with no usage on file, the call is counted and marked unmeasured."""
+        with tempfile.TemporaryDirectory() as tmp:
+            proj = make_project(tmp)
+
+            def builder(project):
+                raise KeyboardInterrupt()
+
+            with self.assertRaises(KeyboardInterrupt):
+                run_pipeline(proj, line(), WorkOrder(id="wo-cp-3b", kind="feature", title="T"),
+                             executor=ScriptedExecutor("wo-cp-3b", actions={"builder": builder}))
+            data = read_report(proj, "wo-cp-3b")
+            self.assertEqual(data["token_usage"]["calls"], 4)
+            self.assertFalse(data["token_usage"]["complete"])
+            self.assertNotIn("usage", data["steps"][-1])
+
+
+class TestAtomicWrite(unittest.TestCase):
+    def test_s5_failed_write_keeps_the_previous_report(self):
+        """run-checkpoint S5: a write that fails leaves the previous report whole."""
+        with tempfile.TemporaryDirectory() as tmp:
+            path = Path(tmp) / "report.json"
+            _write_json_atomic(path, {"run_state": "in_progress"})
+            with self.assertRaises(TypeError):
+                _write_json_atomic(path, {"bad": object()})
+            self.assertEqual(json.loads(path.read_text(encoding="utf-8")), {"run_state": "in_progress"})
+
+    def test_s5_no_temporary_file_is_left_behind(self):
+        """run-checkpoint S5: a finished run leaves no temporary report file."""
+        with tempfile.TemporaryDirectory() as tmp:
+            proj = make_project(tmp)
+            run_pipeline(proj, line(), WorkOrder(id="wo-cp-5", kind="feature", title="T"),
+                         executor=ScriptedExecutor("wo-cp-5"))
+            self.assertEqual(list((proj / "runs" / "wo-cp-5").glob("*.tmp")), [])
+
+
+@unittest.skipUnless(hasattr(signal, "SIGTERM") and os.name == "posix", "needs POSIX signals")
+class TestStopSignal(unittest.TestCase):
+    def test_s6_sigterm_saves_an_aborted_report(self):
+        """run-checkpoint S6: a run stopped with SIGTERM through the CLI saves its report as aborted."""
+        with tempfile.TemporaryDirectory() as tmp:
+            proj = make_project(tmp)
+            sleeper = Path(tmp) / "sleeper.py"
+            sleeper.write_text("import time\ntime.sleep(60)\n", encoding="utf-8")
+            cfg_path = proj / "anvil.yaml"
+            cfg = json.loads(cfg_path.read_text(encoding="utf-8"))
+            cfg["runtime"] = {"kind": "command", "command": f"{sys.executable} {sleeper} {{packet}} {{output}}",
+                              "timeout_seconds": 120}
+            cfg_path.write_text(json.dumps(cfg), encoding="utf-8")
+            wo_file = Path(tmp) / "wo.json"
+            wo_file.write_text(json.dumps({"id": "wo-cp-6", "kind": "feature", "title": "T"}), encoding="utf-8")
+            report_path = proj / "runs" / "wo-cp-6" / "report.json"
+            proc = subprocess.Popen(
+                [sys.executable, "-m", "anvil.cli", "run", str(proj), "--pipeline",
+                 str(ROOT / "pipelines" / "plan-build-test.json"), "--work-order", str(wo_file), "--execute"],
+                cwd=str(ROOT), stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+            try:
+                deadline = time.time() + 30
+                while time.time() < deadline and not report_path.exists():
+                    time.sleep(0.1)
+                self.assertTrue(report_path.exists(), "the run never wrote its first checkpoint")
+                time.sleep(0.3)
+                proc.send_signal(signal.SIGTERM)
+                code = proc.wait(timeout=30)
+            finally:
+                if proc.poll() is None:
+                    proc.kill()
+            self.assertEqual(code, 143)
+            data = json.loads(report_path.read_text(encoding="utf-8"))
+            self.assertEqual(data["run_state"], "aborted")
+            self.assertEqual(data["in_flight"]["station"], "intake")
+            self.assertIn("SystemExit", data["abort_reason"])
+
+
+if __name__ == "__main__":
+    unittest.main()
