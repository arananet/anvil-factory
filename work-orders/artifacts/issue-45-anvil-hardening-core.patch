+"""Tests for .openspec/specs/pre-build-gate/spec.md (S1 to S5)."""
+import json
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+from hardening_helpers import SPEC_FILE, ScriptedExecutor, line, make_project, read_report, write  # noqa: E402
+
+from anvil.gates import pre_build_gate, spec_slug_of  # noqa: E402
+from anvil.model import WorkOrder  # noqa: E402
+from anvil.runner import run_pipeline  # noqa: E402
+
+
+def add_scenario(project):
+    path = Path(project) / SPEC_FILE
+    path.write_text(path.read_text(encoding="utf-8") + "\n- S2: Given x, when y, then z.\n", encoding="utf-8")
+
+
+def test_for(*ids):
+    return lambda p: write(p, "tests/test_feature.py",
+                           f'def test_feature():\n    """demo-feature {", ".join(ids)}"""\n    assert True\n')
+
+
+def gate_step(data):
+    return next((s for s in data["steps"] if s["station"] == "pre-build-gate"), None)
+
+
+class TestGateFunction(unittest.TestCase):
+    def test_s4_nothing_to_check_is_not_applicable(self):
+        """pre-build-gate S4: no spec identified and checks not required is not applicable."""
+        with tempfile.TemporaryDirectory() as tmp:
+            self.assertEqual(pre_build_gate(tmp, [], {})["status"], "not_applicable")
+
+    def test_s3_required_checks_missing_fails(self):
+        """pre-build-gate S3: require_checks with no check command fails readiness."""
+        with tempfile.TemporaryDirectory() as tmp:
+            result = pre_build_gate(tmp, [], {"require_checks": True, "checks": []})
+            self.assertEqual(result["status"], "failed")
+            self.assertIn("configures no check command", result["findings"][0])
+            self.assertEqual(pre_build_gate(tmp, [], {"require_checks": True, "checks": ["true"]})["status"], "passed")
+
+    def test_spec_slug_of(self):
+        """pre-build-gate S5: only .openspec/specs/<slug>/spec.md names a spec."""
+        self.assertEqual(spec_slug_of(".openspec/specs/demo-feature/spec.md"), "demo-feature")
+        self.assertIsNone(spec_slug_of(".openspec/config.yaml"))
+        self.assertIsNone(spec_slug_of(""))
+        self.assertIsNone(spec_slug_of(".openspec/specs/a/b/spec.md"))
+
+
+class TestRunnerGate(unittest.TestCase):
+    def run_line(self, tmp, wo_id, actions, wo_kwargs=None, config=None):
+        proj = make_project(tmp)
+        if config:
+            path = proj / "anvil.json"
+            data = json.loads(path.read_text(encoding="utf-8"))
+            data.update(config)
+            path.write_text(json.dumps(data), encoding="utf-8")
+        executor = ScriptedExecutor(wo_id, actions=actions)
+        report = run_pipeline(proj, line(), WorkOrder(id=wo_id, kind="feature", title="T", **(wo_kwargs or {})),
+                              executor=executor)
+        return proj, executor, report
+
+    def test_s1_scenario_without_a_test_stops_before_the_builder(self):
+        """pre-build-gate S1: a new scenario with no test reference means the builder is never called."""
+        with tempfile.TemporaryDirectory() as tmp:
+            proj, executor, report = self.run_line(tmp, "wo-pb-1", {
+                "spec-writer": add_scenario, "test-writer": test_for("S1")})
+            self.assertNotIn("builder", executor.calls)
+            self.assertEqual(report.verdict, "gate_failed")
+            step = gate_step(read_report(proj, "wo-pb-1"))
+            self.assertEqual(step["status"], "failed")
+            self.assertIn("S2", " ".join(step["findings"]))
+            self.assertEqual(step["specs"][0]["slug"], "demo-feature")
+
+    def test_s2_every_scenario_in_the_tests_lets_the_builder_run(self):
+        """pre-build-gate S2: the gate passes and is recorded as a step before the builder."""
+        with tempfile.TemporaryDirectory() as tmp:
+            proj, executor, report = self.run_line(tmp, "wo-pb-2", {
+                "spec-writer": add_scenario, "test-writer": test_for("S1", "S2")})
+            self.assertIn("builder", executor.calls)
+            self.assertEqual(report.verdict, "approved")
+            stations = [s["station"] for s in read_report(proj, "wo-pb-2")["steps"]]
+            self.assertEqual(stations.index("pre-build-gate") + 1, stations.index("builder"))
+            self.assertEqual(gate_step(read_report(proj, "wo-pb-2"))["status"], "passed")
+
+    def test_s3_project_that_requires_checks_and_has_none_does_not_start_the_builder(self):
+        """pre-build-gate S3: a project that cannot verify its work does not pay for a build."""
+        with tempfile.TemporaryDirectory() as tmp:
+            proj, executor, report = self.run_line(tmp, "wo-pb-3", {}, config={"require_checks": True})
+            self.assertNotIn("builder", executor.calls)
+            self.assertEqual(report.verdict, "gate_failed")
+            self.assertFalse(gate_step(read_report(proj, "wo-pb-3"))["checks_configured"])
+
+    def test_s4_run_with_nothing_to_check_has_no_gate_step(self):
+        """pre-build-gate S4: an untouched spec and no requirement adds no step."""
+        with tempfile.TemporaryDirectory() as tmp:
+            proj, executor, report = self.run_line(tmp, "wo-pb-4", {})
+            self.assertIsNone(gate_step(read_report(proj, "wo-pb-4")))
+            self.assertEqual(report.verdict, "approved")
+
+    def test_s5_the_spec_the_work_order_names_is_checked(self):
+        """pre-build-gate S5: the work order's spec_path is checked even when spec-writer changed nothing."""
+        with tempfile.TemporaryDirectory() as tmp:
+            proj, executor, report = self.run_line(tmp, "wo-pb-5", {}, wo_kwargs={"spec_path": SPEC_FILE})
+            self.assertNotIn("builder", executor.calls)
+            self.assertEqual(report.verdict, "gate_failed")
+        with tempfile.TemporaryDirectory() as tmp:
+            proj, executor, report = self.run_line(tmp, "wo-pb-5b", {"test-writer": test_for("S1")},
+                                                   wo_kwargs={"spec_path": SPEC_FILE})
+            self.assertEqual(report.verdict, "approved")
+
+
+if __name__ == "__main__":
+    unittest.main()
