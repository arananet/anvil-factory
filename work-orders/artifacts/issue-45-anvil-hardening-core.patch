+"""Tests for .openspec/specs/write-authority/spec.md (S1 to S8)."""
+import json
+import os
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+from hardening_helpers import (REVIEWERS, SPEC_FILE, ScriptedExecutor, line, make_project,  # noqa: E402
+                               read_report, write)
+
+from anvil.gates import (DEFAULT_PROTECTED_PATHS, DEFAULT_WRITE_OWNERS, checks_gate,  # noqa: E402
+                         protected_write_violations, resolve_protected_paths, resolve_write_owners,
+                         snapshot_protected)
+from anvil.model import WorkOrder  # noqa: E402
+from anvil.runner import run_pipeline  # noqa: E402
+
+TEST_FILE = "tests/test_feature.py"
+
+
+def append(rel, text):
+    def action(project):
+        path = Path(project) / rel
+        path.write_text(path.read_text(encoding="utf-8") + text, encoding="utf-8")
+    return action
+
+
+def writes_test(project):
+    # Names both scenario ids, so the pre-build gate finds every scenario in the tests.
+    write(project, TEST_FILE, "def test_feature():\n    \"\"\"demo-feature S1, S2\"\"\"\n    assert True\n")
+
+
+class TestSnapshotAndRule(unittest.TestCase):
+    def test_s8_snapshot_compares_content_not_time(self):
+        """write-authority S8: a touch is not a change; an edit is, whatever its timestamp."""
+        with tempfile.TemporaryDirectory() as tmp:
+            write(tmp, "tests/test_a.py", "a = 1\n")
+            before = snapshot_protected(tmp, ["tests/"])
+            target = Path(tmp) / "tests" / "test_a.py"
+            stat = target.stat()
+            os.utime(target, (stat.st_atime + 100, stat.st_mtime + 100))
+            self.assertEqual(snapshot_protected(tmp, ["tests/"]), before)
+            target.write_text("a = 2\n", encoding="utf-8")
+            os.utime(target, (stat.st_atime, stat.st_mtime))
+            after = snapshot_protected(tmp, ["tests/"])
+            self.assertEqual(
+                protected_write_violations("builder", before, after, ["tests/"], DEFAULT_WRITE_OWNERS),
+                [{"station": "builder", "path": "tests/test_a.py", "change": "modified", "prefix": "tests/"}])
+
+    def test_s8_snapshot_covers_single_files_and_skips_bytecode(self):
+        """write-authority S8: a file prefix is hashed; compiled bytecode is never judged."""
+        with tempfile.TemporaryDirectory() as tmp:
+            write(tmp, "anvil.json", "{}\n")
+            write(tmp, "tests/test_a.py", "a = 1\n")
+            write(tmp, "tests/__pycache__/test_a.cpython-311.pyc", "x")
+            write(tmp, "src/app.py", "x = 1\n")
+            self.assertEqual(sorted(snapshot_protected(tmp, ["tests/", "anvil.json", ".anvil/"])),
+                             ["anvil.json", "tests/test_a.py"])
+
+    def test_s3_owner_may_change_its_prefix(self):
+        """write-authority S3: spec-writer owns .openspec/ and test-writer owns tests/."""
+        before = {SPEC_FILE: "1", TEST_FILE: "1"}
+        after = {SPEC_FILE: "2", TEST_FILE: "2"}
+        paths = [".openspec/", "tests/"]
+        spec_writer = protected_write_violations("spec-writer", before, after, paths, DEFAULT_WRITE_OWNERS)
+        self.assertEqual([v["path"] for v in spec_writer], [TEST_FILE])
+        test_writer = protected_write_violations("test-writer", before, after, paths, DEFAULT_WRITE_OWNERS)
+        self.assertEqual([v["path"] for v in test_writer], [SPEC_FILE])
+        self.assertEqual(protected_write_violations("blueprint", {SPEC_FILE: "1"}, {SPEC_FILE: "2"},
+                                                    paths, DEFAULT_WRITE_OWNERS), [])
+
+    def test_s4_new_and_own_files_are_never_violations(self):
+        """write-authority S4: additions and a station's own earlier files are not judged."""
+        paths = ["tests/"]
+        self.assertEqual(protected_write_violations("builder", {}, {"tests/test_new.py": "1"},
+                                                    paths, DEFAULT_WRITE_OWNERS), [])
+        self.assertEqual(protected_write_violations("builder", {"tests/test_mine.py": "1"}, {"tests/test_mine.py": "2"},
+                                                    paths, DEFAULT_WRITE_OWNERS, own_files={"tests/test_mine.py"}), [])
+
+    def test_s2_deletion_is_a_violation_and_unowned_prefix_has_no_writer(self):
+        """write-authority S2: deleting counts, and a prefix with no owner is closed to every station."""
+        found = protected_write_violations("test-writer", {"anvil.json": "1", TEST_FILE: "1"}, {TEST_FILE: "1"},
+                                           ["tests/", "anvil.json"], DEFAULT_WRITE_OWNERS)
+        self.assertEqual(found, [{"station": "test-writer", "path": "anvil.json", "change": "deleted",
+                                  "prefix": "anvil.json"}])
+
+    def test_s6_defaults_and_config_override(self):
+        """write-authority S6: defaults protect tests, specs and config; the base ref config can replace them."""
+        self.assertEqual(DEFAULT_PROTECTED_PATHS, ["tests/", ".openspec/", "anvil.json", ".anvil/"])
+        self.assertEqual(resolve_protected_paths({}), DEFAULT_PROTECTED_PATHS)
+        self.assertEqual(resolve_protected_paths(None), DEFAULT_PROTECTED_PATHS)
+        self.assertEqual(resolve_protected_paths({"protected_paths": ["spec/"]}), ["spec/"])
+        self.assertEqual(resolve_write_owners({}), DEFAULT_WRITE_OWNERS)
+        self.assertEqual(resolve_write_owners({"write_owners": {"spec/": ["spec-writer"]}}),
+                         {"spec/": ["spec-writer"]})
+
+
+class TestGateRule(unittest.TestCase):
+    def test_s5_protected_path_rule_applies_without_checks(self):
+        """write-authority S5: with no checks configured, a protected file change still fails the gate."""
+        with tempfile.TemporaryDirectory() as tmp:
+            write(tmp, TEST_FILE, "x = 1\n")
+            result = checks_gate("pre-review", {}, {TEST_FILE}, tmp, "wo-x", preexisting_files={TEST_FILE})
+            self.assertEqual((result["gate_verdict"], result["status"]), ("fail", "failed"))
+            self.assertEqual(result["commands"], [])
+            self.assertIn(TEST_FILE, result["protected_path_findings"][0])
+
+    def test_s5_no_checks_and_no_violation_is_still_not_configured(self):
+        """write-authority S5: without a violation the gate reports not configured, as before."""
+        with tempfile.TemporaryDirectory() as tmp:
+            result = checks_gate("pre-review", {}, {"src/app.py", "tests/test_new.py"}, tmp, "wo-x")
+            self.assertEqual((result["gate_verdict"], result["status"]), ("not_configured", "not_configured"))
+            self.assertEqual(result["protected_path_findings"], [])
+
+    def test_s1_run_written_file_is_judged_like_a_base_ref_file(self):
+        """write-authority S1: with checks configured, a file written earlier in the run is protected too."""
+        with tempfile.TemporaryDirectory() as tmp:
+            config = {"checks": ["true"], "protected_paths": ["tests/"]}
+            failed = checks_gate("pre-review", config, {TEST_FILE}, tmp, "wo-x", preexisting_files={TEST_FILE})
+            self.assertEqual(failed["gate_verdict"], "fail")
+            self.assertIn("written earlier in this run", failed["protected_path_findings"][0])
+            passed = checks_gate("pre-review", config, {TEST_FILE}, tmp, "wo-x")
+            self.assertEqual(passed["gate_verdict"], "pass")
+            self.assertEqual(len(passed["observed_additions"]), 1)
+
+
+class TestRunnerEnforcesAuthority(unittest.TestCase):
+    def run_line(self, tmp, wo_id, actions):
+        proj = make_project(tmp)
+        executor = ScriptedExecutor(wo_id, actions=actions)
+        report = run_pipeline(proj, line(), WorkOrder(id=wo_id, kind="feature", title="T"), executor=executor)
+        return proj, executor, report
+
+    def test_s1_builder_amending_a_run_written_test_fails_the_gate(self):
+        """write-authority S1, S7: the builder rewriting the test-writer's test stops before review."""
+        with tempfile.TemporaryDirectory() as tmp:
+            proj, executor, report = self.run_line(tmp, "wo-wa-1", {
+                "test-writer": writes_test,
+                "builder": lambda p: write(p, TEST_FILE, "def test_feature():\n    return True\n")})
+            data = read_report(proj, "wo-wa-1")
+            gate = next(s for s in data["steps"] if s["station"] == "checks-gate")
+            self.assertEqual(gate["gate_verdict"], "fail")
+            self.assertIn(TEST_FILE, gate["protected_path_findings"][0])
+            self.assertEqual([c for c in executor.calls if c.startswith("reviewer")], [])
+            self.assertEqual(report.verdict, "rejected")
+            self.assertTrue(report.human_required)
+            builder = next(s for s in data["steps"] if s["station"] == "builder")
+            self.assertEqual(builder["integrity_violations"][0]["path"], TEST_FILE)
+            self.assertEqual(data["integrity"]["violations"][0]["station"], "builder")
+
+    def test_s1_builder_amending_the_run_spec_fails_the_gate(self):
+        """write-authority S1: the builder editing the spec it was given stops before review."""
+        with tempfile.TemporaryDirectory() as tmp:
+            proj, executor, report = self.run_line(tmp, "wo-wa-1b", {"builder": append(SPEC_FILE, "\n- S2: easier.\n")})
+            self.assertEqual(report.verdict, "rejected")
+            self.assertEqual([c for c in executor.calls if c.startswith("reviewer")], [])
+
+    def test_s2_reviewer_editing_the_spec_is_rejected_despite_passing_reviews(self):
+        """write-authority S2, S7: four passing reviews do not approve a run whose reviewer edited the spec."""
+        with tempfile.TemporaryDirectory() as tmp:
+            proj, executor, report = self.run_line(tmp, "wo-wa-2", {
+                "reviewer-spec": append(SPEC_FILE, "\nAmended during review.\n")})
+            self.assertEqual([c for c in executor.calls if c.startswith("reviewer")], REVIEWERS)
+            self.assertEqual(report.verdict, "rejected")
+            rule = report.decision["approver"]["rule"]
+            self.assertIn("regardless of the reviews", rule)
+            self.assertIn("reviewer-spec modified " + SPEC_FILE, rule)
+            data = read_report(proj, "wo-wa-2")
+            self.assertEqual(data["integrity"]["violations"],
+                             [{"station": "reviewer-spec", "path": SPEC_FILE, "change": "modified",
+                               "prefix": ".openspec/", "restored": True}])
+            self.assertEqual(data["integrity"]["protected_paths"], DEFAULT_PROTECTED_PATHS)
+            self.assertTrue(any("reviewer-spec" in w for w in data["warnings"]))
+
+    def test_s3_owners_writing_their_prefix_is_approved(self):
+        """write-authority S3: spec-writer editing the spec and test-writer writing tests is normal work."""
+        with tempfile.TemporaryDirectory() as tmp:
+            proj, executor, report = self.run_line(tmp, "wo-wa-3", {
+                "spec-writer": append(SPEC_FILE, "\n- S2: Given x, when y, then z.\n"),
+                "test-writer": writes_test})
+            self.assertEqual(report.verdict, "approved")
+            self.assertEqual(read_report(proj, "wo-wa-3")["integrity"]["violations"], [])
+
+    def test_s4_builder_adding_a_test_file_is_approved(self):
+        """write-authority S4: a builder adding its own test file is not a violation."""
+        with tempfile.TemporaryDirectory() as tmp:
+            proj, executor, report = self.run_line(tmp, "wo-wa-4", {
+                "test-writer": writes_test,
+                "builder": lambda p: (write(p, "src/app.py", "x = 1\n"),
+                                      write(p, "tests/test_extra.py", "def test_extra():\n    assert True\n"))})
+            self.assertEqual(report.verdict, "approved")
+            self.assertEqual(read_report(proj, "wo-wa-4")["integrity"]["violations"], [])
+
+    def test_s7_packet_mode_has_no_integrity_section(self):
+        """write-authority S7: nothing ran, so the report claims no integrity judgment."""
+        with tempfile.TemporaryDirectory() as tmp:
+            proj = make_project(tmp)
+            run_pipeline(proj, line(), WorkOrder(id="wo-wa-7", kind="feature", title="T"))
+            self.assertNotIn("integrity", read_report(proj, "wo-wa-7"))
