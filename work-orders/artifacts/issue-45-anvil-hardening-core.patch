+            self.assertEqual(report.verdict, "approved")
+            self.assertNotIn("escalations", routing(proj, "wo-cf-5"))
+
+    def test_s6_sensitive_change_restores_the_full_panel_before_review(self):
+        """classification-floor S6, S8: a builder touching auth code under a reduced panel gets the full panel."""
+        with tempfile.TemporaryDirectory() as tmp:
+            proj = make_project(tmp)
+            executor = ScriptedExecutor("wo-cf-6", intake=intake("low", []),
