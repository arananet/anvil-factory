+    return [c for c in executor.calls if c.startswith("reviewer")]
+
+
+class TestIntakeRules(unittest.TestCase):
+    def test_s1_intake_cannot_lower_a_submitted_risk(self):
+        """classification-floor S1: a submitted risk is a floor."""
+        result = classify_after_intake("high", [], {"risk": "low"})
+        self.assertEqual(result["risk"], "high")
+        self.assertIn("never lower", " ".join(result["decisions"]))
+        self.assertEqual(result["intake_proposed"]["risk"], "low")
+
+    def test_s2_intake_can_raise_the_risk(self):
+        """classification-floor S2: intake raises low to high."""
+        result = classify_after_intake("low", [], {"risk": "high"})
+        self.assertEqual(result["risk"], "high")
+        self.assertIn("raised", " ".join(result["decisions"]))
+
+    def test_s3_surfaces_are_a_union(self):
+        """classification-floor S3: intake adds surfaces and cannot remove submitted ones."""
+        result = classify_after_intake(None, ["security", "api"], {"surfaces": ["ui"]})
+        self.assertEqual(sorted(result["surfaces"]), ["api", "security", "ui"])
+        self.assertIn("never remove", " ".join(result["decisions"]))
+
+    def test_s4_low_is_refused_on_an_unrated_order_with_risk_hints(self):
+        """classification-floor S4: unrated plus a scanned risk hint stays unrated."""
+        result = classify_after_intake(None, [], {"risk": "low"}, ["payments"])
+        self.assertIsNone(result["risk"])
+        self.assertIn("refused", " ".join(result["decisions"]))
+
+    def test_s5_unrated_order_takes_the_intake_rating(self):
+        """classification-floor S5: with no risk hint, intake rates an unrated order."""
+        self.assertEqual(classify_after_intake(None, [], {"risk": "low"})["risk"], "low")
+        self.assertEqual(classify_after_intake(None, [], {"risk": "medium"}, ["auth"])["risk"], "medium")
+
+    def test_no_proposal_keeps_the_submitted_values(self):
+        """classification-floor S1: intake that proposes nothing changes nothing."""
+        result = classify_after_intake("medium", ["api"], {})
+        self.assertEqual((result["risk"], result["surfaces"], result["decisions"]), ("medium", ["api"], []))
+
+
+class TestContentRules(unittest.TestCase):
+    def test_s6_paths_signal_sensitive_surfaces(self):
+        """classification-floor S6: the path table finds security, data, payments and deploy."""
+        found = surfaces_from_paths(["src/auth/login.py", "db/migrations/001_init.sql",
+                                     ".github/workflows/ci.yml", "src/billing.py", "src/util.py"])
+        self.assertEqual(sorted(found), ["data", "deploy", "payments", "security"])
+        self.assertEqual(found["security"], ["src/auth/login.py"])
+
+    def test_s6_ordinary_paths_signal_nothing(self):
