+"""Shared helpers for the hardening specs' tests (not a test module).
+
+Specs: run-checkpoint, classification-floor, write-authority,
+station-token-caps, scaffold-checks.
+"""
+import json
+import sys
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent.parent
+if str(ROOT) not in sys.path:
+    sys.path.insert(0, str(ROOT))
+
+from anvil.pipeline import Pipeline  # noqa: E402
+from anvil.scaffold import init_project, scaffold_spec  # noqa: E402
+
+REVIEWERS = ["reviewer-spec", "reviewer-security", "reviewer-tests", "reviewer-architecture"]
+SPEC_FILE = ".openspec/specs/demo-feature/spec.md"
+
+
+def line(reviewers=None):
+    """A short software line: intake to approver, no design stations."""
+    return Pipeline(name="hardening", stages=[
+        {"station": "intake"}, {"station": "spec-writer"}, {"station": "test-writer"},
+        {"station": "builder"}, {"station": "checks-gate"},
+        {"parallel": list(reviewers or REVIEWERS)}, {"station": "approver"}])
+
+
+def make_project(tmp, efficiency=None):
+    proj = Path(tmp) / "proj"
+    init_project(proj, "Demo")
+    scaffold_spec(proj, "demo-feature", "Demo Feature")
+    if efficiency is not None:
+        cfg_path = proj / "anvil.yaml"
+        cfg = json.loads(cfg_path.read_text(encoding="utf-8"))
+        cfg["efficiency"] = efficiency
+        cfg_path.write_text(json.dumps(cfg, indent=2) + "\n", encoding="utf-8")
+    return proj
+
+
+def read_report(proj, wo_id):
+    return json.loads((Path(proj) / "runs" / wo_id / "report.json").read_text(encoding="utf-8"))
+
+
+def write(project, rel, text):
+    path = Path(project) / rel
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(text, encoding="utf-8")
+
+
+class ScriptedExecutor:
+    """An in-process runtime: accepts the work at intake, passes every review,
+    and runs a per-station action (a callable taking the project path)."""
+
+    kind = "fake"
+    name = "fake"
+    writes_artifacts = True
+
+    def __init__(self, wo_id, intake=None, actions=None, usage=None, reviews=None):
+        self.wo_id = wo_id
+        self.intake = intake if intake is not None else {"intake_outcome": {"outcome": "accepted"}}
+        self.actions = actions or {}
+        self.usage = usage or {}
+        # station -> verdict, or a callable taking the call number (1, 2, ...)
+        self.reviews = reviews or {}
+        self.calls = []
+        self.packets = {}
+        self.models = {}
+
+    def count(self, station_id):
+        return self.calls.count(station_id)
+
+    def execute(self, packet_text, station_id, packet_path=None, output_path=None, cwd=None,
+                configured_model=None):
+        self.calls.append(station_id)
+        self.packets.setdefault(station_id, []).append(packet_text)
+        self.models[station_id] = configured_model
+        project = Path(cwd)
+        action = self.actions.get(station_id)
+        if action:
+            action(project)
+        usage = self.usage.get(station_id, {"input_tokens": 100, "output_tokens": 0})
+        if station_id == "intake":
+            return {"output": json.dumps(self.intake), "usage": usage}
+        if station_id.startswith("reviewer"):
+            verdict = self.reviews.get(station_id, "pass")
+            if callable(verdict):
+                verdict = verdict(self.count(station_id))
+            findings = [] if verdict == "pass" else [f"{station_id} found a defect"]
+            write(project, f"runs/{self.wo_id}/{station_id}.review.json",
+                  json.dumps({"station": station_id, "verdict": verdict, "findings": findings}))
+        return {"output": f"{station_id} done", "usage": usage}
+
+
+class RecordingCommandExecutor(ScriptedExecutor):
+    """Looks like the command executor to the runner, so it receives the
+    runtime limits; records the limits handed to each station."""
+
+    kind = "command"
+    name = "command"
+    template = "fake-runtime"
+
+    def __init__(self, *args, **kwargs):
+        super().__init__(*args, **kwargs)
+        self.limits = {}
+        self.handoffs = {}
+
+    def execute(self, packet_text, station_id, **kwargs):
+        self.handoffs[station_id] = dict(self.limits)
+        return super().execute(packet_text, station_id, **kwargs)
