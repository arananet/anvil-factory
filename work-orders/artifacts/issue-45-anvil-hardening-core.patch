+            report = run_pipeline(proj, line(), WorkOrder(id="wo-cf-6", kind="feature", title="T"),
+                                  executor=executor)
+            self.assertEqual(reviewers_run(executor), REVIEWERS)
+            self.assertEqual(report.verdict, "approved")
+            self.assertEqual(len(report.decision["approver"]["reviews_counted"]), 4)
+            record = routing(proj, "wo-cf-6")
+            self.assertEqual(len(record["escalations"]), 1)
+            escalation = record["escalations"][0]
+            self.assertEqual(escalation["panel_before"], REDUCED)
+            self.assertEqual(escalation["panel_after"], REVIEWERS)
+            self.assertEqual(escalation["detected"], {"security": ["src/auth/login.py"]})
+            saved = json.loads((proj / "work_orders" / "wo-cf-6.json").read_text(encoding="utf-8"))
+            self.assertEqual((saved["risk"], saved["surfaces"]), ("medium", ["security"]))
+            report_md = (proj / "runs" / "wo-cf-6" / "report.md").read_text(encoding="utf-8")
+            self.assertIn("**Classification**", report_md)
+            self.assertIn("**Escalations** (1)", report_md)
+
+    def test_s7_ui_change_adds_the_ui_surface(self):
+        """classification-floor S7: a builder writing HTML adds the ui surface to the work order."""
+        with tempfile.TemporaryDirectory() as tmp:
+            proj = make_project(tmp)
+            executor = ScriptedExecutor("wo-cf-7", intake=intake("medium", []),
+                                        actions={"builder": lambda p: write(p, "public/index.html", "<p>x</p>\n")})
+            run_pipeline(proj, line(), WorkOrder(id="wo-cf-7", kind="feature", title="T"), executor=executor)
+            saved = json.loads((proj / "work_orders" / "wo-cf-7.json").read_text(encoding="utf-8"))
+            self.assertEqual(saved["surfaces"], ["ui"])
+            self.assertEqual(routing(proj, "wo-cf-7")["escalations"][0]["detected"], {"ui": ["public/index.html"]})
+
+    def test_s9_malformed_intake_risk_still_fails_the_run(self):
+        """classification-floor S9: an unknown risk level from intake raises, as before."""
+        with tempfile.TemporaryDirectory() as tmp:
+            proj = make_project(tmp)
+            with self.assertRaises(RiskValidationError):
+                run_pipeline(proj, line(), WorkOrder(id="wo-cf-9", kind="feature", title="T"),
+                             executor=ScriptedExecutor("wo-cf-9", intake=intake("CRITICAL")))
+
+
+if __name__ == "__main__":
