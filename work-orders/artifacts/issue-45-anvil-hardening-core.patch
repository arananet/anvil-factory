--- /dev/null
+++ b/tests/test_in_run_loopback.py
@@ -0,0 +1,132 @@
+"""Tests for .openspec/specs/in-run-loopback/spec.md (S1 to S7)."""
+import json
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+from hardening_helpers import REVIEWERS, ScriptedExecutor, line, make_project, read_report, write  # noqa: E402
+
+from anvil.model import WorkOrder  # noqa: E402
+from anvil.runner import run_pipeline  # noqa: E402
+
+TEST_FILE = "tests/test_feature.py"
+
+
+def fails_first(call):
+    return "changes_requested" if call == 1 else "pass"
+
+
+def run(tmp, wo_id, mode=None, config=None, efficiency=None, **executor_kwargs):
+    proj = make_project(tmp, efficiency=efficiency)
+    if config:
+        path = proj / "anvil.json"
+        data = json.loads(path.read_text(encoding="utf-8"))
+        data.update(config)
+        path.write_text(json.dumps(data), encoding="utf-8")
+    executor = ScriptedExecutor(wo_id, **executor_kwargs)
+    report = run_pipeline(proj, line(), WorkOrder(id=wo_id, kind="feature", title="T"),
+                          executor=executor, loopback_mode=mode)
+    return proj, executor, report
+
+
+class TestLoopbackModes(unittest.TestCase):
+    def test_s1_record_mode_notes_the_loopback_and_does_not_rerun(self):
+        """in-run-loopback S1: the default records the loopback; the builder runs once."""
+        with tempfile.TemporaryDirectory() as tmp:
+            proj, executor, report = run(tmp, "wo-lb-1", reviews={"reviewer-tests": "changes_requested"})
+            self.assertEqual(executor.count("builder"), 1)
+            self.assertEqual((report.verdict, report.loopbacks), ("changes_requested", 1))
+            self.assertNotIn("loopback_mode", read_report(proj, "wo-lb-1"))
+
+    def test_s2_s3_in_run_sends_the_work_back_and_the_second_attempt_is_approved(self):
+        """in-run-loopback S2, S3: the builder runs again with the findings, and the run ends approved."""
+        with tempfile.TemporaryDirectory() as tmp:
+            proj, executor, report = run(tmp, "wo-lb-2", mode="in_run", reviews={"reviewer-tests": fails_first})
+            self.assertEqual(executor.count("builder"), 2)
+            self.assertEqual([executor.count(r) for r in REVIEWERS], [2, 2, 2, 2])
+            self.assertEqual(executor.count("spec-writer"), 1)
+            self.assertEqual((report.verdict, report.loopbacks), ("approved", 1))
+            self.assertFalse(report.human_required)
+            # Only the second attempt's reviews are counted.
+            counted = report.decision["approver"]["reviews_counted"]
+            self.assertEqual({c["verdict"] for c in counted}, {"pass"})
+            self.assertEqual(len(counted), 4)
+            first, second = executor.packets["builder"]
+            self.assertNotIn("## Loopback feedback", first)
+            self.assertIn("## Loopback feedback", second)
+            self.assertIn("reviewer-tests found a defect", second)
+            data = read_report(proj, "wo-lb-2")
+            self.assertEqual(data["loopback_mode"], "in_run")
+            self.assertEqual([s["status"] for s in data["steps"]].count("loopback"), 1)
+
+    def test_s4_in_run_loopbacks_stop_at_the_limit(self):
+        """in-run-loopback S4: a reviewer that never passes ends the run after max_loopbacks."""
+        with tempfile.TemporaryDirectory() as tmp:
+            # Three attempts are 18 agent calls; lift the call limit so the loopback limit is what stops it.
+            proj, executor, report = run(tmp, "wo-lb-4", mode="in_run", efficiency={"max_agent_calls": 40},
+                                         reviews={"reviewer-tests": "changes_requested"})
+            self.assertEqual(executor.count("builder"), 3)   # first attempt plus two loopbacks
+            self.assertEqual((report.verdict, report.loopbacks), ("changes_requested", 2))
+            self.assertTrue(report.human_required)
+
+    def test_s4_the_run_budget_still_bounds_in_run_loopbacks(self):
+        """in-run-loopback S4: with the default 16 call limit, the budget stops the run first."""
+        with tempfile.TemporaryDirectory() as tmp:
+            proj, executor, report = run(tmp, "wo-lb-4b", mode="in_run",
+                                         reviews={"reviewer-tests": "changes_requested"})
+            self.assertEqual(report.verdict, "budget_exceeded")
+            self.assertEqual(len(executor.calls), 16)
+
+    def test_s5_gate_failure_loops_back_in_run(self):
+        """in-run-loopback S5: a builder that amends a sealed test is sent back, and a clean retry is approved."""
+        with tempfile.TemporaryDirectory() as tmp:
+            attempts = []
+
+            def builder(project):
+                attempts.append(1)
+                if len(attempts) == 1:
+                    write(project, TEST_FILE, "def test_feature():\n    assert True\n")
+
+            sealed = 'def test_feature():\n    """demo-feature S1"""\n    assert False\n'
+            proj, executor, report = run(tmp, "wo-lb-5", mode="in_run", actions={
+                "test-writer": lambda p: write(p, TEST_FILE, sealed), "builder": builder})
+            self.assertEqual(executor.count("builder"), 2)
+            self.assertEqual(executor.count("reviewer-spec"), 1)     # no reviewer on the failed attempt
+            self.assertEqual((report.verdict, report.loopbacks), ("approved", 1))
+            self.assertEqual((proj / TEST_FILE).read_text(encoding="utf-8"), sealed)
+            data = read_report(proj, "wo-lb-5")
+            # The violation of the first attempt stays on record, restored.
+            self.assertEqual(len(data["integrity"]["violations"]), 1)
+            self.assertTrue(data["integrity"]["violations"][0]["restored"])
+            self.assertIn("Gate output", executor.packets["builder"][1])
+
+    def test_s6_unknown_mode_is_rejected(self):
+        """in-run-loopback S6: only record and in_run are modes."""
+        with tempfile.TemporaryDirectory() as tmp:
+            with self.assertRaises(ValueError):
+                run(tmp, "wo-lb-6", mode="forever")
+
+    def test_s7_mode_comes_from_the_project_config(self):
+        """in-run-loopback S7: loopback_mode in anvil.json switches the mode; the argument wins over it."""
+        with tempfile.TemporaryDirectory() as tmp:
+            proj, executor, report = run(tmp, "wo-lb-7", config={"loopback_mode": "in_run"},
+                                         reviews={"reviewer-tests": fails_first})
+            self.assertEqual((executor.count("builder"), report.verdict), (2, "approved"))
+        with tempfile.TemporaryDirectory() as tmp:
+            proj, executor, report = run(tmp, "wo-lb-7b", mode="record", config={"loopback_mode": "in_run"},
+                                         reviews={"reviewer-tests": fails_first})
+            self.assertEqual(executor.count("builder"), 1)
+
+    def test_s1_packet_mode_never_loops(self):
+        """in-run-loopback S1: with no runtime there is nothing to run again."""
+        with tempfile.TemporaryDirectory() as tmp:
+            proj = make_project(tmp)
+            report = run_pipeline(proj, line(), WorkOrder(id="wo-lb-1b", kind="feature", title="T"),
+                                  loopback_mode="in_run")
+            self.assertEqual(report.loopbacks, 0)
+
+
+if __name__ == "__main__":
+    unittest.main()
