+        if lower.startswith(_DEPLOY_PREFIXES) or name in _DEPLOY_NAMES or name.startswith("dockerfile") \
+                or lower.endswith(".tf"):
+            add("deploy", path)
+        if lower.endswith(".sql") or name == "schema.prisma" or set(_DATA_PARTS) & set(parts[:-1]):
+            add("data", path)
+        if _SECURITY_RE.search(lower) or name == "codeowners" or name.startswith(".env"):
