@@ -0,0 +1,109 @@
+"""Tests for .openspec/specs/sealed-tests/spec.md (S1 to S6)."""
+import json
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+from hardening_helpers import SPEC_FILE, ScriptedExecutor, line, make_project, read_report, write  # noqa: E402
+
+from anvil.gates import capture_protected, protected_write_violations, restore_protected  # noqa: E402
+from anvil.model import WorkOrder  # noqa: E402
+from anvil.runner import run_pipeline  # noqa: E402
+
+TEST_FILE = "tests/test_feature.py"
+SEALED = 'def test_feature():\n    """demo-feature S1"""\n    assert compute() == 4\n'
+TAMPERED = "def test_feature():\n    assert True\n"
+
+
+def writes_test(project):
+    write(project, TEST_FILE, SEALED)
+
+
+def set_config(proj, **values):
+    path = proj / "anvil.json"
+    config = json.loads(path.read_text(encoding="utf-8"))
+    config.update(values)
+    path.write_text(json.dumps(config, indent=2) + "\n", encoding="utf-8")
+
+
+class TestSealAndRestore(unittest.TestCase):
+    def test_s2_deleted_file_is_recreated(self):
+        """sealed-tests S2: a deleted sealed file is put back with its content."""
+        with tempfile.TemporaryDirectory() as tmp:
+            write(tmp, TEST_FILE, SEALED)
+            hashes, contents = capture_protected(tmp, ["tests/"])
+            (Path(tmp) / TEST_FILE).unlink()
+            after, _ = capture_protected(tmp, ["tests/"])
+            violations = protected_write_violations("builder", hashes, after, ["tests/"], {})
+            self.assertEqual(restore_protected(tmp, violations, contents), [TEST_FILE])
+            self.assertEqual((Path(tmp) / TEST_FILE).read_text(encoding="utf-8"), SEALED)
+            self.assertTrue(violations[0]["restored"])
+
+    def test_s6_file_over_the_size_limit_is_judged_but_not_restored(self):
+        """sealed-tests S6: a file too large to keep is still a violation, marked not restored."""
+        with tempfile.TemporaryDirectory() as tmp:
+            write(tmp, TEST_FILE, "x" * 200)
+            hashes, contents = capture_protected(tmp, ["tests/"], max_file_bytes=100)
+            self.assertIn(TEST_FILE, hashes)
+            self.assertNotIn(TEST_FILE, contents)
+            write(tmp, TEST_FILE, "y")
+            after, _ = capture_protected(tmp, ["tests/"], max_file_bytes=100)
+            violations = protected_write_violations("builder", hashes, after, ["tests/"], {})
+            self.assertEqual(restore_protected(tmp, violations, contents), [])
+            self.assertFalse(violations[0]["restored"])
+            self.assertEqual((Path(tmp) / TEST_FILE).read_text(encoding="utf-8"), "y")
+
+
+class TestRunnerRestores(unittest.TestCase):
+    def test_s1_s4_builder_tampering_is_undone_before_the_checks_run(self):
+        """sealed-tests S1, S4: the checks run against the sealed test, and the violation stays on record."""
+        with tempfile.TemporaryDirectory() as tmp:
+            proj = make_project(tmp)
+            # The check passes only if the test file is the sealed one.
+            set_config(proj, checks=[f"grep -q 'compute() == 4' {TEST_FILE}"])
+            executor = ScriptedExecutor("wo-st-1", actions={
+                "test-writer": writes_test, "builder": lambda p: write(p, TEST_FILE, TAMPERED)})
+            report = run_pipeline(proj, line(), WorkOrder(id="wo-st-1", kind="feature", title="T"), executor=executor)
+            self.assertEqual((proj / TEST_FILE).read_text(encoding="utf-8"), SEALED)
+            data = read_report(proj, "wo-st-1")
+            gate = next(s for s in data["steps"] if s["station"] == "checks-gate")
+            self.assertEqual(gate["exit_codes"], [0])            # ran against the sealed test
+            self.assertEqual(gate["gate_verdict"], "fail")       # and still failed on the violation
+            violation = data["integrity"]["violations"][0]
+            self.assertEqual((violation["station"], violation["path"], violation["restored"]),
+                             ("builder", TEST_FILE, True))
+            self.assertEqual(report.verdict, "rejected")
+            self.assertTrue(any("1 of 1 restored" in w for w in data["warnings"]))
+
+    def test_s3_reviewer_change_to_the_spec_is_undone(self):
+        """sealed-tests S3: a reviewer's edit to the spec does not survive the station."""
+        with tempfile.TemporaryDirectory() as tmp:
+            proj = make_project(tmp)
+            original = (proj / SPEC_FILE).read_text(encoding="utf-8")
+
+            def amend(project):
+                (project / SPEC_FILE).write_text(original + "\nAmended during review.\n", encoding="utf-8")
+
+            report = run_pipeline(proj, line(), WorkOrder(id="wo-st-3", kind="feature", title="T"),
+                                  executor=ScriptedExecutor("wo-st-3", actions={"reviewer-spec": amend}))
+            self.assertEqual((proj / SPEC_FILE).read_text(encoding="utf-8"), original)
+            self.assertEqual(report.verdict, "rejected")
+
+    def test_s5_restore_can_be_switched_off(self):
+        """sealed-tests S5: with restore_protected false the change is recorded and left in place."""
+        with tempfile.TemporaryDirectory() as tmp:
+            proj = make_project(tmp)
+            set_config(proj, restore_protected=False)
+            executor = ScriptedExecutor("wo-st-5", actions={
+                "test-writer": writes_test, "builder": lambda p: write(p, TEST_FILE, TAMPERED)})
+            report = run_pipeline(proj, line(), WorkOrder(id="wo-st-5", kind="feature", title="T"), executor=executor)
+            self.assertEqual((proj / TEST_FILE).read_text(encoding="utf-8"), TAMPERED)
+            violation = read_report(proj, "wo-st-5")["integrity"]["violations"][0]
+            self.assertNotIn("restored", violation)
+            self.assertEqual(report.verdict, "rejected")
+
+
+if __name__ == "__main__":
+    unittest.main()
