+def builder(project):
+    write(project, "src/ledger.py", "def export():\n    return 'ledger-rows'\n")
+    write(project, "runs/wo-cr-1/builder.output.md", "BUILDER-NARRATIVE: everything is fine\n")
+
+
+def run(tmp, wo_id, intake=None, **kwargs):
+    proj = make_project(tmp)
+    executor = ScriptedExecutor(wo_id, intake=intake, actions={"builder": builder}, **kwargs)
+    report = run_pipeline(proj, line(PANEL), WorkOrder(id=wo_id, kind="feature", title=SECRET_TITLE,
+                                                        description="SECRET-DESCRIPTION"),
+                          registry=load_registry(ROOT / "stations"), executor=executor)
+    return proj, executor, report
+
+
+class TestCleanPacket(unittest.TestCase):
+    def test_s1_packet_carries_the_change_and_none_of_the_framing(self):
+        """clean-review S1: the packet has the change, the prompt and the output contract, nothing else."""
+        with tempfile.TemporaryDirectory() as tmp:
+            proj, executor, report = run(tmp, "wo-cr-1")
+            packet = executor.packets["reviewer-clean"][0]
+            self.assertIn("## Change under review", packet)
+            self.assertIn("src/ledger.py", packet)
+            self.assertIn("ledger-rows", packet)
+            self.assertIn("- id: wo-cr-1", packet)
+            self.assertIn("runs/wo-cr-1/reviewer-clean.review.json", packet)
+            for framing in (SECRET_TITLE, "SECRET-DESCRIPTION", "BUILDER-NARRATIVE", "## Upstream steps",
+                            "## Run context", "builder.output.md", "Craft skills", ".openspec/specs/demo-feature"):
+                self.assertNotIn(framing, packet, framing)
+            # The other reviewers still get the usual packet.
+            self.assertIn(SECRET_TITLE, executor.packets["reviewer-spec"][0])
+
+    def test_s3_its_review_counts_like_any_other(self):
+        """clean-review S3: an objection from the clean reviewer keeps the run from being approved."""
+        with tempfile.TemporaryDirectory() as tmp:
+            proj, executor, report = run(tmp, "wo-cr-3", reviews={"reviewer-clean": "changes_requested"})
+            self.assertEqual(report.verdict, "changes_requested")
+            counted = {c["station"]: c["verdict"] for c in report.decision["approver"]["reviews_counted"]}
+            self.assertEqual(counted["reviewer-clean"], "changes_requested")
+            self.assertEqual(len(counted), 5)
+        with tempfile.TemporaryDirectory() as tmp:
+            proj, executor, report = run(tmp, "wo-cr-3b")
+            self.assertEqual(report.verdict, "approved")
+
+
+class TestCleanRouting(unittest.TestCase):
+    def test_s2_runs_on_the_full_panel_with_a_different_model(self):
+        """clean-review S2: selected for unrated, medium and high work, on a model family other than the builder's."""
+        with tempfile.TemporaryDirectory() as tmp:
+            for risk in (None, "medium", "high"):
+                record = route_reviewers(WorkOrder(id="w", kind="feature", title="T", risk=risk), PANEL, Path(tmp))
+                self.assertIn("reviewer-clean", record.selected_reviewers, risk)
+                self.assertEqual(record.selected_models["reviewer-clean"], CLEAN_REVIEW_MODEL)
+            self.assertTrue(CLEAN_REVIEW_MODEL.startswith("openai/"))
+
+    def test_s2_routed_out_on_the_reduced_panel(self):
+        """clean-review S2: low risk work does not pay for it."""
+        with tempfile.TemporaryDirectory() as tmp:
+            record = route_reviewers(WorkOrder(id="w", kind="feature", title="T", risk="low"), PANEL, Path(tmp))
+            self.assertNotIn("reviewer-clean", record.selected_reviewers)
+            self.assertIn("reviewer-clean", [r["reviewer"] for r in record.routed_out])
+
+    def test_s2_the_runtime_is_handed_the_clean_model(self):
+        """clean-review S2: the model reaches the runtime hand-off, not only the record."""
+        with tempfile.TemporaryDirectory() as tmp:
+            proj, executor, report = run(tmp, "wo-cr-2")
+            self.assertEqual(executor.models["reviewer-clean"], CLEAN_REVIEW_MODEL)
+            self.assertNotEqual(executor.models["reviewer-clean"], executor.models["builder"])
+
+
+class TestChangeUnderReview(unittest.TestCase):
+    def test_s4_large_change_is_cut_and_says_so(self):
+        """clean-review S4: a change over the packet budget is cut, and the cut is stated."""
+        with tempfile.TemporaryDirectory() as tmp:
+            for i in range(6):
+                write(tmp, f"src/mod{i}.py", "x = 1\n" * 400)
+            files = [f"src/mod{i}.py" for i in range(6)]
+            text = change_under_review(tmp, None, files, max_tokens=1000)
+            self.assertLess(len(text), 6000)
+            self.assertIn("more changed files are not shown", text)
+            self.assertIn("src/mod0.py", text)
+
+    def test_s4_no_change_is_stated(self):
+        """clean-review S4: with nothing changed the packet says so instead of being empty."""
+        with tempfile.TemporaryDirectory() as tmp:
+            self.assertIn("No change was found", change_under_review(tmp, None, []))
+
+    def test_s1_spec_brain_and_run_output_are_left_out(self):
+        """clean-review S1: files that carry framing are never part of the change shown."""
+        with tempfile.TemporaryDirectory() as tmp:
+            for rel in (".openspec/specs/a/spec.md", "brain/project.md", "runs/w/builder.output.md",
+                        "reviews/a/r.json", "src/app.py", "tests/test_app.py"):
+                write(tmp, rel, f"content of {rel}\n")
+            text = change_under_review(tmp, None, [".openspec/specs/a/spec.md", "brain/project.md",
+                                                   "runs/w/builder.output.md", "reviews/a/r.json",
+                                                   "src/app.py", "tests/test_app.py"])
+            self.assertIn("content of src/app.py", text)
+            self.assertIn("content of tests/test_app.py", text)
+            for hidden in ("spec.md", "brain/", "builder.output.md", "reviews/"):
+                self.assertNotIn(hidden, text)
+
+    def test_s6_with_a_git_base_ref_the_change_is_a_diff(self):
+        """clean-review S6: against a base ref the packet shows the diff and untracked files."""
+        with tempfile.TemporaryDirectory() as tmp:
+            def git(*args):
+                subprocess.run(["git", *args], cwd=tmp, check=True, capture_output=True)
+            write(tmp, "src/app.py", "value = 1\n")
+            write(tmp, ".openspec/specs/a/spec.md", "the spec\n")
+            git("init"); git("config", "user.email", "t@example.com"); git("config", "user.name", "T")
+            git("add", "."); git("commit", "-m", "base")
+            base = subprocess.run(["git", "rev-parse", "HEAD"], cwd=tmp, capture_output=True, text=True).stdout.strip()
+            write(tmp, "src/app.py", "value = 2\n")
+            write(tmp, "src/new.py", "fresh = True\n")
+            write(tmp, ".openspec/specs/a/spec.md", "the spec, amended\n")
+            text = change_under_review(tmp, base, [])
+            self.assertIn("-value = 1", text)
+            self.assertIn("+value = 2", text)
+            self.assertIn("fresh = True", text)
+            self.assertNotIn("amended", text)
+
+
+class TestCatalog(unittest.TestCase):
+    def test_s5_station_and_pipeline_are_in_the_catalog(self):
+        """clean-review S5: the station loads and sdlc-clean-review adds it to the default panel."""
+        registry = load_registry(ROOT / "stations")
+        station = registry.get("reviewer-clean")
+        self.assertEqual((station.kind, station.context), ("agent", []))
+        self.assertIn("Do not open the spec", station.prompt)
+        clean = load_pipeline(ROOT / "pipelines" / "sdlc-clean-review.json", known_stations=set(registry.ids()))
+        default = load_pipeline(ROOT / "pipelines" / "sdlc-default.json", known_stations=set(registry.ids()))
+        self.assertEqual([s for s in clean.topological_order() if s != "reviewer-clean"], default.topological_order())
+        self.assertNotIn("reviewer-clean", default.topological_order())
+
+
+if __name__ == "__main__":
+    unittest.main()
