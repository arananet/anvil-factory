+"""Tests for .openspec/specs/outcome-metrics/spec.md (S1 to S6)."""
+import io
+import json
+import sys
+import tempfile
+import unittest
+from contextlib import redirect_stdout
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+from hardening_helpers import ScriptedExecutor, line, make_project  # noqa: E402
+
+from anvil import cli  # noqa: E402
+from anvil.metrics import outcome_metrics  # noqa: E402
+from anvil.model import WorkOrder  # noqa: E402
+from anvil.runner import run_pipeline  # noqa: E402
+from anvil.statuspage import generate_status_page  # noqa: E402
+
+
+def report(wo, verdict, loopbacks=0, reviews=None, gate=None, tokens=None, state="completed", violations=0):
+    steps = []
+    if tokens is not None:
+        steps.append({"station": "builder", "status": "executed", "executor": {"kind": "command"},
+                      "usage": {"input_tokens": tokens, "output_tokens": 0}})
+    if gate:
+        steps.append({"station": "checks-gate", "status": gate})
+    return {"work_order_id": wo, "verdict": verdict, "loopbacks": loopbacks, "run_state": state, "steps": steps,
+            "integrity": {"violations": [{}] * violations},
+            "decision": {"approver": {"reviews_counted": [{"station": s, "verdict": v}
+                                                          for s, v in (reviews or {}).items()]}}}
+
+
+class TestOutcomeMetrics(unittest.TestCase):
+    def test_s1_rates_over_judged_runs(self):
+        """outcome-metrics S1: approval, first pass and loopback figures come from judged runs only."""
+        m = outcome_metrics([
+            report("a", "approved"),
+            report("b", "approved", loopbacks=1),
+            report("c", "changes_requested", loopbacks=2),
+            report("d", "rejected"),
+            report("e", "packet_ready"),                       # not judged
+            report("f", "incomplete", state="aborted"),        # not judged
+        ])
+        self.assertEqual((m["runs"], m["judged_runs"], m["approved_runs"], m["first_pass_approvals"]), (6, 4, 2, 1))
+        self.assertEqual(m["approval_rate"], 0.5)
+        self.assertEqual(m["first_pass_approval_rate"], 0.25)
+        self.assertEqual(m["loopbacks_per_judged_run"], 0.75)
+        self.assertEqual(m["run_states"], {"completed": 5, "aborted": 1, "in_progress": 0})
+
+    def test_s2_nothing_measured_is_none_not_zero(self):
+        """outcome-metrics S2: a rate with nothing behind it is None."""
+        m = outcome_metrics([report("a", "packet_ready")])
+        for key in ("approval_rate", "first_pass_approval_rate", "loopbacks_per_judged_run",
+                    "gate_failure_rate", "tokens_per_approved_work_order", "total_tokens"):
+            self.assertIsNone(m[key], key)
+        self.assertEqual(outcome_metrics([])["runs"], 0)
+        self.assertEqual(outcome_metrics(None)["reviewers"], {})
+
+    def test_s3_objection_rate_per_reviewer(self):
+        """outcome-metrics S3: each reviewer's objections over the reviews it had counted."""
+        m = outcome_metrics([
+            report("a", "approved", reviews={"reviewer-spec": "pass", "reviewer-tests": "pass"}),
+            report("b", "changes_requested", reviews={"reviewer-spec": "pass", "reviewer-tests": "changes_requested"}),
+            report("c", "rejected", reviews={"reviewer-tests": "fail"}),
+        ])
+        self.assertEqual(m["reviewers"]["reviewer-spec"], {"reviews": 2, "objections": 0, "objection_rate": 0.0})
+        self.assertEqual(m["reviewers"]["reviewer-tests"], {"reviews": 3, "objections": 2, "objection_rate": 0.6667})
+
+    def test_s1_gate_and_integrity_counts(self):
+        """outcome-metrics S1: gate failures over runs where the gate ran; violations are summed."""
+        m = outcome_metrics([
+            report("a", "approved", gate="passed"),
+            report("b", "no_reviews", gate="failed", violations=2),
+            report("c", "approved", gate="not_configured"),    # the gate did not run
+            report("d", "budget_exceeded"),
+        ])
+        self.assertEqual((m["gate_runs"], m["gate_failures"], m["gate_failure_rate"]), (2, 1, 0.5))
+        self.assertEqual((m["integrity_violations"], m["budget_stopped_runs"]), (2, 1))
+
+    def test_s6_tokens_per_approved_work_order_counts_every_run(self):
+        """outcome-metrics S6: failed and earlier runs are part of what an approved work order cost."""
+        m = outcome_metrics([
+            report("a", "changes_requested", tokens=300),      # an earlier run of work order a
+            report("a", "approved", tokens=500),
+            report("b", "rejected", tokens=200),
+        ])
+        self.assertEqual((m["work_orders"], m["approved_work_orders"], m["total_tokens"]), (2, 1, 1000))
+        self.assertEqual(m["tokens_per_approved_work_order"], 1000)
+
+
+class TestWhereTheMetricsAppear(unittest.TestCase):
+    def test_s4_status_page_and_usage_file_carry_the_outcomes(self):
+        """outcome-metrics S4: the status page has an Outcomes panel and usage.json the figures."""
+        with tempfile.TemporaryDirectory() as tmp:
+            proj = make_project(tmp)
+            run_pipeline(proj, line(), WorkOrder(id="wo-om-1", kind="feature", title="T"),
+                         executor=ScriptedExecutor("wo-om-1"))
+            run_pipeline(proj, line(), WorkOrder(id="wo-om-2", kind="feature", title="T"),
+                         executor=ScriptedExecutor("wo-om-2", reviews={"reviewer-tests": "changes_requested"}))
+            generate_status_page(proj)
+            page = (proj / "status" / "index.html").read_text(encoding="utf-8")
+            self.assertIn("<h2>Outcomes</h2>", page)
+            self.assertIn("Approved on the first pass", page)
+            self.assertIn("Objections by reviewer", page)
+            outcomes = json.loads((proj / "status" / "usage.json").read_text(encoding="utf-8"))["outcomes"]
+            self.assertEqual((outcomes["judged_runs"], outcomes["approved_runs"]), (2, 1))
+            self.assertEqual(outcomes["reviewers"]["reviewer-tests"]["objections"], 1)
+            self.assertEqual(outcomes["tokens_per_approved_work_order"], 1600)
+
+    def test_s4_project_with_no_runs_has_no_panel(self):
+        """outcome-metrics S4: nothing recorded, nothing claimed."""
+        with tempfile.TemporaryDirectory() as tmp:
+            proj = make_project(tmp)
+            generate_status_page(proj)
+            self.assertNotIn("<h2>Outcomes</h2>", (proj / "status" / "index.html").read_text(encoding="utf-8"))
+
+    def test_s5_cli_prints_the_metrics(self):
+        """outcome-metrics S5: anvil metrics prints the figures as JSON."""
+        with tempfile.TemporaryDirectory() as tmp:
+            proj = make_project(tmp)
+            run_pipeline(proj, line(), WorkOrder(id="wo-om-5", kind="feature", title="T"),
+                         executor=ScriptedExecutor("wo-om-5"))
+            out = io.StringIO()
+            with redirect_stdout(out):
+                code = cli.main(["metrics", str(proj)])
+            self.assertEqual(code, 0)
+            data = json.loads(out.getvalue())
+            self.assertEqual((data["schema"], data["approved_runs"]), ("anvil/outcomes@1", 1))
+
+
+if __name__ == "__main__":
+    unittest.main()
