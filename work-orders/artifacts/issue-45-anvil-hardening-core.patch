+                             f"(intake may add surfaces, never remove them).")
+
+    return {"risk": risk, "surfaces": surfaces,
+            "submitted": {"risk": submitted_risk, "surfaces": submitted_surfaces},
+            "intake_proposed": {"risk": proposed_risk, "surfaces": proposed_surfaces},
+            "decisions": decisions}
