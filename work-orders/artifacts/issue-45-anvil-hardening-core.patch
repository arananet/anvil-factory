+"""Tests for .openspec/specs/scaffold-checks/spec.md (S1 to S5)."""
+import json
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent.parent
+sys.path.insert(0, str(ROOT))
+
+from anvil.blueprints import get_blueprint, load_blueprints  # noqa: E402
+from anvil.gates import DEFAULT_PROTECTED_PATHS  # noqa: E402
+from anvil.onboard import onboard_project  # noqa: E402
+from anvil.scaffold import init_project, new_project  # noqa: E402
+
+
+def config_of(project):
+    return json.loads((Path(project) / "anvil.json").read_text(encoding="utf-8"))
+
+
+class TestScaffoldChecks(unittest.TestCase):
+    def test_s1_python_service_project_is_born_with_checks(self):
+        """scaffold-checks S1: a python-service project has a check command and protected paths."""
+        with tempfile.TemporaryDirectory() as tmp:
+            proj = new_project(Path(tmp) / "svc", "Svc", get_blueprint(ROOT / "blueprints", "python-service"))
+            config = config_of(proj)
+            self.assertEqual(config["checks"], ["python3 -m unittest discover -s tests"])
+            self.assertEqual(config["protected_paths"], DEFAULT_PROTECTED_PATHS)
+            # pre-build-gate S3: a project born with checks requires them.
+            self.assertTrue(config["require_checks"])
+
+    def test_s2_init_writes_protected_paths_and_no_checks(self):
+        """scaffold-checks S2: init cannot know the stack, so checks start empty and paths are protected."""
+        with tempfile.TemporaryDirectory() as tmp:
+            config = config_of(init_project(Path(tmp) / "p", "P"))
+            self.assertEqual(config["checks"], [])
+            self.assertEqual(config["protected_paths"], DEFAULT_PROTECTED_PATHS)
+
+    def test_s3_malformed_blueprint_checks_are_rejected(self):
+        """scaffold-checks S3: checks must be a list of non-empty command strings."""
+        base = {"id": "x", "name": "X", "stack": ["s"], "structure": ["s"], "first_specs": ["core"]}
+        for bad in ("make test", [""], [1], ["ok", "  "]):
+            with tempfile.TemporaryDirectory() as tmp:
+                (Path(tmp) / "x.json").write_text(json.dumps(dict(base, checks=bad)), encoding="utf-8")
+                with self.assertRaises(ValueError, msg=str(bad)):
+                    load_blueprints(tmp)
+        with tempfile.TemporaryDirectory() as tmp:
+            (Path(tmp) / "x.json").write_text(json.dumps(base), encoding="utf-8")
+            self.assertNotIn("checks", load_blueprints(tmp)["x"])
+
+    def test_s4_blueprint_file_states_the_checks(self):
+        """scaffold-checks S4: BLUEPRINT.md names the check command, or says none is configured."""
+        with tempfile.TemporaryDirectory() as tmp:
+            svc = new_project(Path(tmp) / "svc", "Svc", get_blueprint(ROOT / "blueprints", "python-service"))
+            text = (svc / "BLUEPRINT.md").read_text(encoding="utf-8")
+            self.assertIn("## Checks", text)
+            self.assertIn("`python3 -m unittest discover -s tests`", text)
+            site = new_project(Path(tmp) / "site", "Site", get_blueprint(ROOT / "blueprints", "static-site"))
+            self.assertIn("No check command is configured yet", (site / "BLUEPRINT.md").read_text(encoding="utf-8"))
+            self.assertEqual(config_of(site)["checks"], [])
+            self.assertFalse(config_of(site)["require_checks"])
+            self.assertEqual(config_of(site)["protected_paths"], DEFAULT_PROTECTED_PATHS)
+
+    def test_s5_onboarded_project_gets_protected_paths(self):
+        """scaffold-checks S5: a brownfield project is onboarded with protected paths."""
+        with tempfile.TemporaryDirectory() as tmp:
+            existing = Path(tmp) / "legacy"
+            (existing / "src").mkdir(parents=True)
+            (existing / "src" / "app.py").write_text("x = 1\n", encoding="utf-8")
+            onboard_project(existing)
+            config = config_of(existing)
+            self.assertEqual(config["checks"], [])
+            self.assertEqual(config["protected_paths"], DEFAULT_PROTECTED_PATHS)
+
+
+if __name__ == "__main__":
+    unittest.main()
