+def classify_after_intake(submitted_risk, submitted_surfaces, intake_data, risk_hints_matched=None) -> Dict:
+    """Combine the submitted classification with the intake proposal.
+
+    Rules, all deterministic:
+    - Risk is a floor. A rated work order keeps the higher of its submitted
+      risk and the intake proposal; intake can raise it, never lower it.
+    - An unrated work order takes the intake rating, except that "low" is
+      refused when the work order carries a risk hint the human gate scans
+      for. It then stays unrated, which routes to the full panel.
+    - Surfaces are a union: intake can add a surface, never remove one.
