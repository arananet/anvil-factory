@@ -0,0 +1,101 @@
+"""Tests for .openspec/specs/station-token-caps/spec.md (S1 to S6)."""
+import json
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+from hardening_helpers import RecordingCommandExecutor, line, make_project, read_report  # noqa: E402
+
+from anvil.config import render_anvil_yaml  # noqa: E402
+from anvil.model import WorkOrder  # noqa: E402
+from anvil.runner import run_pipeline  # noqa: E402
+from anvil.telemetry import DEFAULT_EFFICIENCY, efficiency_config, station_token_cap  # noqa: E402
+
+KEY = "ANVIL_MAX_STATION_TOKENS"
+
+
+def run(tmp, wo_id, efficiency, usage=None):
+    proj = make_project(tmp, efficiency=efficiency)
+    executor = RecordingCommandExecutor(wo_id, usage=usage)
+    report = run_pipeline(proj, line(), WorkOrder(id=wo_id, kind="feature", title="T"), executor=executor)
+    return proj, executor, report
+
+
+class TestCapResolution(unittest.TestCase):
+    def test_s2_per_station_cap_overrides_the_default(self):
+        """station-token-caps S2: station_tokens.<station> wins over max_station_tokens."""
+        limits = {"max_station_tokens": 300, "station_tokens": {"builder": 500}}
+        self.assertEqual(station_token_cap(limits, "builder"), 500)
+        self.assertEqual(station_token_cap(limits, "reviewer-spec"), 300)
+        self.assertEqual(station_token_cap({"station_tokens": {"builder": 500}}, "reviewer-spec"), None)
+        self.assertIsNone(station_token_cap({}, "builder"))
+
+    def test_s4_invalid_caps_are_rejected(self):
+        """station-token-caps S4: caps must be positive integers in an object."""
+        for bad in ({"max_station_tokens": 0}, {"max_station_tokens": "many"}, {"max_station_tokens": True},
+                    {"station_tokens": ["builder"]}, {"station_tokens": {"builder": -1}},
+                    {"station_tokens": {"builder": 1.5}}):
+            with self.assertRaises(ValueError, msg=str(bad)):
+                efficiency_config({"efficiency": bad})
+        self.assertEqual(efficiency_config({"efficiency": {"station_tokens": {"builder": 10}}}),
+                         {"station_tokens": {"builder": 10}})
+
+    def test_s5_new_projects_get_the_default_station_cap(self):
+        """station-token-caps S5: the scaffolded anvil.yaml carries a 500,000 token station cap."""
+        self.assertEqual(DEFAULT_EFFICIENCY["max_station_tokens"], 500000)
+        config = json.loads(render_anvil_yaml(["intake", "builder"]))
+        self.assertEqual(config["efficiency"]["max_station_tokens"], 500000)
+        self.assertLess(config["efficiency"]["max_station_tokens"], config["efficiency"]["max_run_tokens"])
+
+
+class TestHandoff(unittest.TestCase):
+    def test_s1_station_receives_the_smaller_of_cap_and_remaining_pool(self):
+        """station-token-caps S1, S2: no station is handed the whole pool."""
+        with tempfile.TemporaryDirectory() as tmp:
+            # Every call reports 100 tokens; the pool is 450.
+            _, executor, report = run(tmp, "wo-tc-1", {"max_run_tokens": 450, "max_station_tokens": 300,
+                                                       "station_tokens": {"builder": 500}})
+            self.assertEqual(executor.handoffs["intake"][KEY], 300)        # cap 300 < pool 450
+            self.assertEqual(executor.handoffs["spec-writer"][KEY], 300)   # cap 300 < remaining 350
+            self.assertEqual(executor.handoffs["test-writer"][KEY], 250)   # remaining 250 < cap 300
+            self.assertEqual(executor.handoffs["builder"][KEY], 150)       # remaining 150 < builder cap 500
+            self.assertEqual(report.verdict, "budget_exceeded")
+
+    def test_s6_without_a_cap_the_handoff_is_the_remaining_pool(self):
+        """station-token-caps S6: no cap configured keeps the earlier behavior."""
+        with tempfile.TemporaryDirectory() as tmp:
+            _, executor, _ = run(tmp, "wo-tc-6", {"max_run_tokens": 10000})
+            self.assertEqual(executor.handoffs["intake"][KEY], 10000)
+            self.assertEqual(executor.handoffs["builder"][KEY], 9700)
+
+    def test_s6_without_any_token_limit_nothing_is_handed_over(self):
+        """station-token-caps S6: no pool and no cap means no token ceiling in the handoff."""
+        with tempfile.TemporaryDirectory() as tmp:
+            proj, executor, _ = run(tmp, "wo-tc-6b", {"max_agent_calls": 16})
+            self.assertNotIn(KEY, executor.handoffs["builder"])
+            builder = next(s for s in read_report(proj, "wo-tc-6b")["steps"] if s["station"] == "builder")
+            self.assertNotIn("station_token_cap", builder)
+
+
+class TestOverrunIsRecorded(unittest.TestCase):
+    def test_s3_call_over_its_cap_is_marked_and_warned(self):
+        """station-token-caps S3: an overrun is stated on the step and in the report warnings."""
+        with tempfile.TemporaryDirectory() as tmp:
+            proj, _, report = run(tmp, "wo-tc-3", {"max_station_tokens": 300},
+                                  usage={"builder": {"input_tokens": 900, "output_tokens": 0}})
+            data = read_report(proj, "wo-tc-3")
+            builder = next(s for s in data["steps"] if s["station"] == "builder")
+            self.assertEqual(builder["station_token_cap"], 300)
+            self.assertTrue(builder["station_cap_exceeded"])
+            self.assertTrue(any("builder used 900 tokens, over its cap of 300" in w for w in data["warnings"]))
+            spec_writer = next(s for s in data["steps"] if s["station"] == "spec-writer")
+            self.assertEqual(spec_writer["station_token_cap"], 300)
+            self.assertNotIn("station_cap_exceeded", spec_writer)
+            # The overrun is recorded, not a verdict: the line carries on.
+            self.assertEqual(report.verdict, "approved")
+
+
+if __name__ == "__main__":
+    unittest.main()
